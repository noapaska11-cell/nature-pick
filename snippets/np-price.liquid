{%- comment -%}
  Price block. Mirrors the React <Price /> component:
  - normal:   "199 kr"
  - on sale:  struck-through compare-at price + sale price
  - B2B:      struck-through retail price + wholesale price + "B2B" badge
              (only for a logged-in customer who carries the B2B tag; the wholesale price comes
               from the per-SKU price list in Theme settings > B2B, or the fallback percentage).

  Params:
    product   - product (uses selected_or_first_available_variant)
    variant   - optional variant object (overrides product's variant)
    class     - classes for the wrapping <span>
    show_from - true to prefix "From" when the price varies between variants (cards)
{%- endcomment -%}
{%- liquid
  if variant
    assign target = variant
  else
    assign target = product.selected_or_first_available_variant
  endif

  assign price = target.price
  assign compare_at = target.compare_at_price
  assign use_from = false
  if product.price_varies and show_from
    assign use_from = true
    assign price = product.price
    assign compare_at = product.compare_at_price
  endif

  assign b2b_customer = false
  if customer
    if customer.b2b? or customer.tags contains settings.b2b_customer_tag
      assign b2b_customer = true
    endif
  endif

  assign b2b_active = false
  assign b2b_shop_cents = nil
  assign wholesale = price
  if b2b_customer
    capture wholesale_major
      render 'np-b2b-wholesale-price', sku: target.sku
    endcapture
    assign wholesale_major = wholesale_major | strip
    if wholesale_major != ''
      assign wholesale = wholesale_major | plus: 0 | times: 100 | round
      assign b2b_active = true
      # the price list is in the shop's currency (SEK); Liquid has no exchange rate, so in any other
      # currency naturepick.js converts it with Shopify's live rate and the retail price stands in until then
      if cart.currency.iso_code != shop.currency
        assign b2b_shop_cents = wholesale
        assign wholesale = price
      endif
    elsif settings.b2b_discount_percent > 0
      assign multiplier = 100 | minus: settings.b2b_discount_percent
      assign wholesale = price | times: multiplier | divided_by: 100
      assign b2b_active = true
    endif
  endif

  assign price_text = price | money_without_trailing_zeros
  assign wholesale_text = wholesale | money_without_trailing_zeros
-%}
{%- if b2b_active -%}
  {%- comment -%}
    data-retail-text / data-b2b-text let the B2B price-view toggle (naturepick.js, header switch) swap
    every price on the site between wholesale and retail without a page reload - a display preference
    only, it never changes what Shopify actually charges at checkout.
  {%- endcomment -%}
  {%- if b2b_shop_cents -%}
    {%- comment -%} data-b2b-text is filled in by naturepick.js from data-b2b-shop-cents (see above) {%- endcomment -%}
    <span class="{{ class }}" data-np-price data-b2b-price data-retail-text="{{ price_text }}" data-b2b-shop-cents="{{ b2b_shop_cents }}">
      <span hidden data-price-strike class="mr-2 align-middle text-[0.6em] font-normal text-[var(--color-charcoal-soft)] line-through">{{ price_text }}</span>
      <span data-price-main>{{ price_text }}</span>
      <span hidden data-price-badge class="ml-2 inline-block align-middle rounded-full bg-[var(--color-paprika)] px-2 py-0.5 text-[0.55em] font-bold uppercase tracking-wide text-[var(--color-charcoal)]">{{ 'np.common.b2b_badge' | t }}</span>
    </span>
  {%- else -%}
  <span class="{{ class }}" data-np-price data-b2b-price data-retail-text="{{ price_text }}" data-b2b-text="{{ wholesale_text }}" aria-label="{{ 'np.common.b2b_price_aria' | t: wholesale: wholesale_text, retail: price_text | strip_html }}">
    <span aria-hidden="true" data-price-strike class="mr-2 align-middle text-[0.6em] font-normal text-[var(--color-charcoal-soft)] line-through">{{ price_text }}</span>
    <span aria-hidden="true" data-price-main>{{ wholesale_text }}</span>
    <span aria-hidden="true" data-price-badge class="ml-2 inline-block align-middle rounded-full bg-[var(--color-paprika)] px-2 py-0.5 text-[0.55em] font-bold uppercase tracking-wide text-[var(--color-charcoal)]">{{ 'np.common.b2b_badge' | t }}</span>
  </span>
  {%- endif -%}
{%- elsif compare_at > price -%}
  <span class="{{ class }}" data-np-price>
    <s class="mr-2 align-middle text-[0.6em] font-normal text-[var(--color-charcoal-soft)]"><span class="sr-only">{{ 'products.product.price.regular_price' | t }}</span>{{ compare_at | money_without_trailing_zeros }}</s>
    <span class="sr-only">{{ 'products.product.price.sale_price' | t }}</span>
    {%- if use_from -%}
      {{ 'products.product.price.from_price_html' | t: price: price_text }}
    {%- else -%}
      {{ price_text }}
    {%- endif -%}
  </span>
{%- else -%}
  <span class="{{ class }}" data-np-price>
    {%- if use_from -%}
      {{ 'products.product.price.from_price_html' | t: price: price_text }}
    {%- else -%}
      {{ price_text }}
    {%- endif -%}
  </span>
{%- endif -%}
