{%- comment -%}
  B2B company login: e-mail + OIB (company tax ID), the same two values entered at registration. No password, no
  Shopify customer account - the <np-b2b-login> element in naturepick.js posts them to the verification service,
  stores the returned token in the browser and reloads the page so <np-b2b-session> shows the logged-in view.
  Params: endpoint (service URL, already pointed at /login)
{%- endcomment -%}
<np-b2b-login
  class="block"
  data-endpoint="{{ endpoint }}"
  data-msg-required="{{ 'np.b2b_auth.error_required' | t }}"
  data-msg-email="{{ 'np.b2b_auth.error_email' | t }}"
  data-msg-not-found="{{ 'np.b2b_auth.login_error_not_found' | t }}"
  data-msg-pending="{{ 'np.b2b_auth.login_error_pending' | t }}"
  data-msg-rejected="{{ 'np.b2b_auth.login_error_rejected' | t }}"
  data-msg-generic="{{ 'np.b2b_auth.error_generic' | t }}"
  data-label-submit="{{ 'np.b2b_auth.login_submit' | t }}"
  data-label-verifying="{{ 'np.b2b_auth.login_verifying' | t }}"
>
  <p class="mb-4 text-sm leading-relaxed text-[var(--color-charcoal-soft)]">{{ 'np.b2b_auth.login_hint' | t }}</p>
  <form novalidate data-b2b-login-form class="flex flex-col gap-4">
    <div>
      <label for="b2b-login-email" class="mb-1.5 block text-sm font-medium text-[var(--color-charcoal)]">{{ 'np.b2b_auth.email' | t }}</label>
      <input id="b2b-login-email" name="email" type="email" required maxlength="160" autocomplete="email" aria-describedby="b2b-login-email-error" class="input-field">
      <p id="b2b-login-email-error" data-error-for="email" hidden class="mt-1 text-xs text-[var(--color-paprika-dark)]"></p>
    </div>

    <div>
      <label for="b2b-login-oib" class="mb-1.5 block text-sm font-medium text-[var(--color-charcoal)]">{{ 'np.b2b_auth.oib' | t }}</label>
      <input id="b2b-login-oib" name="oib" type="text" required maxlength="20" autocomplete="off" placeholder="12345678901" aria-describedby="b2b-login-oib-error" class="input-field">
      <p id="b2b-login-oib-error" data-error-for="oib" hidden class="mt-1 text-xs text-[var(--color-paprika-dark)]"></p>
    </div>

    <p data-b2b-login-error hidden role="alert" class="rounded-xl bg-[var(--color-paprika-light)] px-4 py-3 text-sm text-[var(--color-paprika-dark)]"></p>

    <button type="submit" class="btn-primary mt-1" data-b2b-login-submit>
      <span data-b2b-login-submit-icon>{% render 'icon', name: 'lock', class: 'h-4 w-4' %}</span>
      <span data-b2b-login-submit-label>{{ 'np.b2b_auth.login_submit' | t }}</span>
    </button>
  </form>
</np-b2b-login>
