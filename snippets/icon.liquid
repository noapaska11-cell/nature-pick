{%- comment -%}
  Inline SVG icon set (same glyphs as the Next.js <Icon /> component).
  Usage: {% render 'icon', name: 'cart', class: 'h-5 w-5', stroke: 1.6 %}
{%- endcomment -%}
{%- liquid
  assign icon_class = class | default: 'w-5 h-5'
  assign icon_stroke = stroke | default: 1.6
-%}
