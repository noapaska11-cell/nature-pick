{%- comment -%}
  Contact form (React <ContactForm />) posting to Shopify's own contact endpoint - messages arrive
  in the store's customer-service inbox. The same snippet drives the B2B tabs.

  Params:
    kind    - 'contact' (default) | 'b2b_register' | 'b2b_quote'
    form_id - unique id for this form on the page

  b2b_register is the B2B registration WITHOUT a server (the default): four required fields (company, e-mail,
  OIB, VAT number) checked by <np-b2b-native> in naturepick.js, then posted to Shopify. The owner approves the
  company by hand in the Shopify admin. The form sends no tags on purpose: a visitor must never be able to give
  himself the B2B tag.
{%- endcomment -%}
{%- liquid
  assign cf_kind = kind | default: 'contact'
  assign cf_id = form_id | default: 'ContactForm'
  assign form_class = 'flex flex-col gap-3 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6'
  assign sent_title_key = 'np.contact_form.sent_title'
  assign sent_text_key = 'np.contact_form.sent_text'
  if cf_kind == 'b2b_register'
    assign form_class = 'flex flex-col gap-4'
    assign sent_title_key = 'np.b2b_auth.sent_title'
    assign sent_text_key = 'np.b2b_auth.sent_text'
  endif
-%}
{%- if cf_kind == 'b2b_register' -%}
  <np-b2b-native
    class="block"
    data-msg-required="{{ 'np.b2b_auth.error_required' | t }}"
    data-msg-email="{{ 'np.b2b_auth.error_email' | t }}"
    data-msg-oib="{{ 'np.b2b_auth.error_oib' | t }}"
    data-msg-id="{{ 'np.b2b_auth.error_id' | t }}"
    data-msg-vat="{{ 'np.b2b_auth.error_vat' | t }}"
  >
{%- endif -%}
{%- form 'contact', id: cf_id, class: form_class -%}
  {%- if form.posted_successfully? -%}
    <div class="flex flex-col items-center gap-3 p-4 text-center" role="status">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-olive-light)] text-[var(--color-olive-dark)]">
        {% render 'icon', name: 'check', class: 'h-6 w-6' %}
      </span>
      <h3 class="font-display text-xl font-semibold text-[var(--color-charcoal)]">{{ sent_title_key | t }}</h3>
      <p class="max-w-sm text-sm leading-relaxed text-[var(--color-charcoal-soft)]">{{ sent_text_key | t }}</p>
    </div>
  {%- else -%}
    {%- if form.errors -%}
      <div class="rounded-xl bg-[var(--color-paprika-light)] px-4 py-3 text-sm text-[var(--color-paprika-dark)]" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    {%- if cf_kind == 'b2b_register' -%}
      <input type="hidden" name="contact[Request type]" value="B2B registration">
      <input type="hidden" name="contact[body]" value="B2B registration request">
      <input type="hidden" name="contact[Language]" value="{{ request.locale.iso_code }}">

      <div>
        <label for="{{ cf_id }}-company" class="mb-1.5 block text-sm font-medium text-[var(--color-charcoal)]">{{ 'np.b2b_auth.company_name' | t }}</label>
        <input id="{{ cf_id }}-company" name="contact[name]" required maxlength="120" autocomplete="organization" aria-describedby="{{ cf_id }}-company-error" class="input-field">
        <p id="{{ cf_id }}-company-error" data-error-for="contact[name]" hidden class="mt-1 text-xs text-[var(--color-paprika-dark)]"></p>
      </div>

      <div>
        <label for="{{ cf_id }}-email" class="mb-1.5 block text-sm font-medium text-[var(--color-charcoal)]">{{ 'np.b2b_auth.email' | t }}</label>
        <input id="{{ cf_id }}-email" name="contact[email]" type="email" required maxlength="160" autocomplete="email" aria-describedby="{{ cf_id }}-email-error" class="input-field">
        <p id="{{ cf_id }}-email-error" data-error-for="contact[email]" hidden class="mt-1 text-xs text-[var(--color-paprika-dark)]"></p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="{{ cf_id }}-oib" class="mb-1.5 block text-sm font-medium text-[var(--color-charcoal)]">{{ 'np.b2b_auth.oib' | t }}</label>
          <input id="{{ cf_id }}-oib" name="contact[OIB]" required maxlength="20" autocomplete="off" placeholder="12345678901" aria-describedby="{{ cf_id }}-oib-error" class="input-field">
          <p id="{{ cf_id }}-oib-error" data-error-for="contact[OIB]" hidden class="mt-1 text-xs text-[var(--color-paprika-dark)]"></p>
        </div>
        <div>
          <label for="{{ cf_id }}-vat" class="mb-1.5 block text-sm font-medium text-[var(--color-charcoal)]">{{ 'np.b2b_auth.vat_number' | t }}</label>
          <input id="{{ cf_id }}-vat" name="contact[VAT number]" required maxlength="20" autocomplete="off" autocapitalize="characters" placeholder="HR12345678901" aria-describedby="{{ cf_id }}-vat-error" class="input-field uppercase placeholder:normal-case">
          <p id="{{ cf_id }}-vat-error" data-error-for="contact[VAT number]" hidden class="mt-1 text-xs text-[var(--color-paprika-dark)]"></p>
        </div>
      </div>
      <p class="-mt-2 text-xs text-[var(--color-charcoal-soft)]">{{ 'np.b2b_auth.vat_hint' | t }}</p>

      <button type="submit" class="btn-primary mt-1 self-start">
        {% render 'icon', name: 'building', class: 'h-4 w-4' %} {{ 'np.b2b_auth.register_submit' | t }}
      </button>
    {%- else -%}
      {%- if cf_kind == 'b2b_quote' -%}
        <input type="hidden" name="contact[Request type]" value="B2B quote">
        <label for="{{ cf_id }}-company" class="sr-only">{{ 'np.b2b_auth.company_name' | t }}</label>
        <input id="{{ cf_id }}-company" name="contact[Company]" required autocomplete="organization" placeholder="{{ 'np.b2b_auth.company_name' | t }}" class="input-field">
      {%- endif -%}

      <div class="grid gap-3 sm:grid-cols-2">
        <label for="{{ cf_id }}-name" class="sr-only">{{ 'np.contact_form.name' | t }}</label>
        <input id="{{ cf_id }}-name" name="contact[name]" required autocomplete="name" placeholder="{{ 'np.contact_form.name' | t }}" value="{% if customer %}{{ customer.name | escape }}{% else %}{{ form.name | escape }}{% endif %}" class="input-field">
        <label for="{{ cf_id }}-email" class="sr-only">{{ 'np.contact_form.email' | t }}</label>
        <input id="{{ cf_id }}-email" name="contact[email]" required type="email" autocomplete="email" placeholder="{{ 'np.contact_form.email' | t }}" value="{% if customer %}{{ customer.email | escape }}{% else %}{{ form.email | escape }}{% endif %}" class="input-field">
      </div>

      {%- if cf_kind == 'contact' -%}
        <label for="{{ cf_id }}-order" class="sr-only">{{ 'np.contact_form.order_number' | t }}</label>
        <input id="{{ cf_id }}-order" name="contact[Order number]" placeholder="{{ 'np.contact_form.order_number' | t }}" class="input-field">
      {%- endif -%}

      <label for="{{ cf_id }}-body" class="sr-only">{{ 'np.contact_form.message' | t }}</label>
      <textarea id="{{ cf_id }}-body" name="contact[body]" required rows="5" placeholder="{{ 'np.contact_form.message' | t }}" class="input-field resize-none">{{ form.body }}</textarea>

      <button type="submit" class="btn-primary self-start">{{ 'np.contact_form.submit' | t }}</button>
    {%- endif -%}
  {%- endif -%}
{%- endform -%}
{%- if cf_kind == 'b2b_register' -%}
  </np-b2b-native>
{%- endif -%}
