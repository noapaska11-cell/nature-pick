{%- comment -%}
  <head> content that must come BEFORE {{ content_for_header }}.
  Shared by layout/theme.liquid and the GemPages layouts so both stay identical.
{%- endcomment -%}
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_cream }}">
<link rel="canonical" href="{{ canonical_url }}">
<script src="https://t.contentsquare.net/uxa/ae3b982e64382.js" async></script>

{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
{%- endif -%}

{%- liquid
  # Search result title: product names typed in CAPITALS read in sentence case, as on the page (snippet np-title)
  assign seo_title = page_title
  if request.page_type == 'product'
    capture seo_title
      render 'np-title', title: page_title
    endcapture
  endif
  # Home page without its own title (Online Store > Preferences): say what the shop sells, in the visitor's language
  if request.page_type == 'index' and page_title == shop.name
    assign seo_home_title = 'np.seo.home_title' | t
    unless seo_home_title contains 'ranslation missing'
      assign seo_title = seo_home_title
    endunless
  endif
  assign seo_title = seo_title | strip

  # Search result text when Shopify has none (no SEO description and no text in the admin): the same translated
  # texts the page itself shows, so every language gets its own description
  assign seo_description = page_description | strip_html | strip
  if seo_description == blank
    case request.page_type
      when 'index'
        assign seo_description = 'np.seo.home_description' | t
      when 'product'
        assign seo_description = 'np.seo.product_description' | t: title: seo_title
      when 'collection'
        if collection.handle == 'all'
          assign seo_description = 'np.collection.all_products_description' | t
        else
          assign seo_description_key = 'np.categories.' | append: collection.handle | replace: '-', '_' | append: '.description'
          assign seo_description = seo_description_key | t
        endif
      when 'page'
        case page.handle
          when 'faq'
            assign seo_description = 'np.faq.page_description' | t
          when 'about'
            assign seo_description = 'np.about_page.meta_description' | t
          when 'origin'
            assign seo_description = 'np.origin_page.meta_description' | t
          when 'contact'
            assign seo_description = 'np.contact_page.meta_description' | t
          when 'b2b'
            assign seo_description = 'np.b2b_page.meta_description' | t
          when 'spice-club'
            assign seo_description = 'np.spice_club_page.meta_description' | t
          when 'shipping-returns'
            assign seo_description = 'np.shipping_returns_page.meta_description' | t
        endcase
    endcase
    if seo_description contains 'ranslation missing'
      assign seo_description = ''
    endif
  endif
  assign seo_description = seo_description | strip_html | newline_to_br | replace: '<br />', ' ' | strip_newlines | replace: '  ', ' ' | replace: '  ', ' ' | strip | truncate: 160

  # Pages that must not show up in Google: search results, cart, customer account, wishlist, password page,
  # HoReCa products and the HoReCa collection (a visitor who is not an approved B2B customer only sees a login
  # notice there), and anything hidden with the seo.hidden metafield (which also removes it from the sitemap)
  assign seo_noindex = false
  case request.page_type
    when 'search', 'cart', 'password', 'gift_card', 'captcha'
      assign seo_noindex = true
    when 'page'
      if page.handle == 'wishlist' or page.template_suffix == 'wishlist'
        assign seo_noindex = true
      endif
    when 'product'
      capture seo_horeca
        render 'np-horeca-gate', product: product
      endcapture
      if seo_horeca contains 'locked'
        assign seo_noindex = true
      endif
    when 'collection'
      if collection.handle == 'horeca'
        assign seo_noindex = true
        if customer
          capture seo_b2b
            render 'np-b2b-customer'
          endcapture
          if seo_b2b contains 'true'
            assign seo_noindex = false
          endif
        endif
      endif
  endcase
  if request.page_type contains 'customers/'
    assign seo_noindex = true
  endif
  if product.metafields.seo.hidden.value == 1 or collection.metafields.seo.hidden.value == 1 or page.metafields.seo.hidden.value == 1 or article.metafields.seo.hidden.value == 1
    assign seo_noindex = true
  endif
-%}

<title>
  {{- seo_title | escape_once -}}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' | escape_once }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name | escape_once }}{% endunless -%}
</title>

{%- if seo_description != blank -%}
  <meta name="description" content="{{ seo_description | escape_once }}">
{%- endif -%}

{%- if seo_noindex -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

{%- comment -%}
  Search Console / Bing Webmaster Tools ownership (Theme settings > SEO). The setting takes the code alone or the whole
  <meta ...> tag the tool shows - only the content value is used.
{%- endcomment -%}
{%- if settings.google_site_verification != blank -%}
  {%- assign seo_verify = settings.google_site_verification | split: 'content="' | last | split: '"' | first | strip -%}
  <meta name="google-site-verification" content="{{ seo_verify | escape }}">
{%- endif -%}
{%- if settings.bing_site_verification != blank -%}
  {%- assign seo_verify = settings.bing_site_verification | split: 'content="' | last | split: '"' | first | strip -%}
  <meta name="msvalidate.01" content="{{ seo_verify | escape }}">
{%- endif -%}

{%- render 'meta-tags', seo_title: seo_title, seo_description: seo_description -%}

{%- comment -%} Fallback share image when a page has no image of its own {%- endcomment -%}
{%- unless page_image -%}
  {%- if settings.share_image != blank -%}
    <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta property="og:image" content="https:{{ 'np-og-image.png' | asset_url }}">
  {%- endif -%}
{%- endunless -%}

{% comment %}theme-check-disable AssetPreload{% endcomment %}
<link rel="preload" href="{{ 'fraunces-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'manrope-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
{% comment %}theme-check-enable AssetPreload{% endcomment %}

<script>
  document.documentElement.classList.add('js');
  if (window.Shopify && Shopify.designMode) {
    document.documentElement.classList.add('shopify-design-mode');
  }
  // Safety net: sections that fade in on scroll are hidden until naturepick.js has started. If the script is blocked,
  // fails or is slow (an app conflict, a network problem), show everything after 4 seconds instead of a half empty page.
  window.setTimeout(function () {
    if (!document.documentElement.hasAttribute('data-np-ready')) document.documentElement.classList.add('np-no-script');
  }, 4000);
</script>
