{%- comment -%}
  The B2B registration fields, shared by the service form (np-b2b-register-form) and the no-server fallback
  (np-contact-form, kind 'b2b_register'): first name, last name, e-mail, contact phone, country (dropdown), company
  address (street, postal code, city), VAT number - and, only with the service, password + confirmation (a password
  must never travel through Shopify's contact form / the owner's inbox).
  Every input carries data-field="<key>" and has a <p data-error-for="<key>">, so one script (naturepick.js,
  checkB2bRegistration) validates both forms the same way; the service validates everything again on its side.
  Countries: every country of np-b2b-country-list (ISO code, English name, dialling code); naturepick.js shows the
  names in the visitor's language. The phone has its own dialling-code picker (flag + code, e.g. +385), which follows
  the selected country until the visitor picks another code; the number is sent as "+385 91 234 5678".
  Params: prefix (unique id prefix), native (true = Shopify contact form names), with_password (true/false)
{%- endcomment -%}
{%- liquid
  assign label_class = 'mb-1.5 block text-sm font-medium text-[var(--color-charcoal)]'
  assign error_class = 'mt-1 text-xs text-[var(--color-paprika-dark)]'
  capture country_data
    render 'np-b2b-country-list'
  endcapture
  assign countries = country_data | strip | split: '|'
  # the visitor's own country (Shopify localization) is preselected, for the country and the dialling code
  assign preselect = localization.country.iso_code
-%}
{%- capture f_first -%}{% if native %}contact[First name]{% else %}firstName{% endif %}{%- endcapture -%}
{%- capture f_last -%}{% if native %}contact[Last name]{% else %}lastName{% endif %}{%- endcapture -%}
{%- capture f_email -%}{% if native %}contact[email]{% else %}email{% endif %}{%- endcapture -%}
{%- capture f_phone -%}{% if native %}contact[Phone]{% else %}phone{% endif %}{%- endcapture -%}
{%- capture f_country -%}{% if native %}contact[Country]{% else %}country{% endif %}{%- endcapture -%}
{%- capture f_street -%}{% if native %}contact[Street]{% else %}street{% endif %}{%- endcapture -%}
{%- capture f_zip -%}{% if native %}contact[Postal code]{% else %}zip{% endif %}{%- endcapture -%}
{%- capture f_city -%}{% if native %}contact[City]{% else %}city{% endif %}{%- endcapture -%}
{%- capture f_vat -%}{% if native %}contact[VAT number]{% else %}vat{% endif %}{%- endcapture -%}

<div class="grid gap-4 sm:grid-cols-2">
  <div>
    <label for="{{ prefix }}-first" class="{{ label_class }}">{{ 'np.b2b_auth.first_name' | t }}</label>
    <input id="{{ prefix }}-first" name="{{ f_first }}" data-field="firstName" type="text" required maxlength="60" autocomplete="given-name" aria-describedby="{{ prefix }}-first-error" class="input-field">
    <p id="{{ prefix }}-first-error" data-error-for="firstName" hidden class="{{ error_class }}"></p>
  </div>
  <div>
    <label for="{{ prefix }}-last" class="{{ label_class }}">{{ 'np.b2b_auth.last_name' | t }}</label>
    <input id="{{ prefix }}-last" name="{{ f_last }}" data-field="lastName" type="text" required maxlength="60" autocomplete="family-name" aria-describedby="{{ prefix }}-last-error" class="input-field">
    <p id="{{ prefix }}-last-error" data-error-for="lastName" hidden class="{{ error_class }}"></p>
  </div>
</div>

<div>
  <label for="{{ prefix }}-email" class="{{ label_class }}">{{ 'np.b2b_auth.email' | t }}</label>
  <input id="{{ prefix }}-email" name="{{ f_email }}" data-field="email" type="email" required maxlength="160" autocomplete="email" inputmode="email" aria-describedby="{{ prefix }}-email-error" class="input-field">
  <p id="{{ prefix }}-email-error" data-error-for="email" hidden class="{{ error_class }}"></p>
</div>

<div>
  <label for="{{ prefix }}-country" class="{{ label_class }}">{{ 'np.b2b_auth.country' | t }}</label>
  <select id="{{ prefix }}-country" name="{{ f_country }}" data-field="country" data-country-select required autocomplete="country" aria-describedby="{{ prefix }}-country-error" class="input-field">
    <option value="">{{ 'np.b2b_auth.country_placeholder' | t }}</option>
    {%- for entry in countries -%}
      {%- assign c = entry | split: ':' -%}
      <option value="{{ c[0] }}" data-dial="{{ c[2] }}"{% if c[0] == preselect %} selected{% endif %}>{{ c[1] }}</option>
    {%- endfor -%}
  </select>
  <p id="{{ prefix }}-country-error" data-error-for="country" hidden class="{{ error_class }}"></p>
</div>

<div>
  <label for="{{ prefix }}-phone" class="{{ label_class }}">{{ 'np.b2b_auth.phone' | t }}</label>
  <div class="flex gap-2">
    <select data-dial-select aria-label="{{ 'np.b2b_auth.dial_code' | t }}" autocomplete="tel-country-code" class="input-field flex-shrink-0 px-3" style="width: 8.5rem">
      {%- for entry in countries -%}
        {%- assign c = entry | split: ':' -%}
        <option value="{{ c[0] }}" data-dial="{{ c[2] }}"{% if c[0] == preselect %} selected{% endif %}>{{ c[0] }} +{{ c[2] }}</option>
      {%- endfor -%}
    </select>
    <input id="{{ prefix }}-phone" name="{{ f_phone }}" data-field="phone" type="tel" required maxlength="30" autocomplete="tel-national" inputmode="tel" placeholder="91 234 5678" aria-describedby="{{ prefix }}-phone-error" class="input-field min-w-0 flex-1">
  </div>
  <p id="{{ prefix }}-phone-error" data-error-for="phone" hidden class="{{ error_class }}"></p>
</div>

<fieldset class="flex flex-col gap-4">
  <legend class="{{ label_class }}">{{ 'np.b2b_auth.company_address' | t }}</legend>
  <div>
    <label for="{{ prefix }}-street" class="sr-only">{{ 'np.b2b_auth.street' | t }}</label>
    <input id="{{ prefix }}-street" name="{{ f_street }}" data-field="street" type="text" required maxlength="120" autocomplete="street-address" placeholder="{{ 'np.b2b_auth.street' | t }}" aria-describedby="{{ prefix }}-street-error" class="input-field">
    <p id="{{ prefix }}-street-error" data-error-for="street" hidden class="{{ error_class }}"></p>
  </div>
  <div class="grid grid-cols-[9rem_1fr] gap-4">
    <div>
      <label for="{{ prefix }}-zip" class="sr-only">{{ 'np.b2b_auth.zip' | t }}</label>
      <input id="{{ prefix }}-zip" name="{{ f_zip }}" data-field="zip" type="text" required maxlength="10" autocomplete="postal-code" placeholder="{{ 'np.b2b_auth.zip' | t }}" aria-describedby="{{ prefix }}-zip-error" class="input-field">
      <p id="{{ prefix }}-zip-error" data-error-for="zip" hidden class="{{ error_class }}"></p>
    </div>
    <div>
      <label for="{{ prefix }}-city" class="sr-only">{{ 'np.b2b_auth.city' | t }}</label>
      <input id="{{ prefix }}-city" name="{{ f_city }}" data-field="city" type="text" required maxlength="60" autocomplete="address-level2" placeholder="{{ 'np.b2b_auth.city' | t }}" aria-describedby="{{ prefix }}-city-error" class="input-field">
      <p id="{{ prefix }}-city-error" data-error-for="city" hidden class="{{ error_class }}"></p>
    </div>
  </div>
</fieldset>

<div>
  <label for="{{ prefix }}-vat" class="{{ label_class }}">{{ 'np.b2b_auth.vat_number' | t }}</label>
  <input id="{{ prefix }}-vat" name="{{ f_vat }}" data-field="vat" data-vat-input type="text" required maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="HR12345678901" aria-describedby="{{ prefix }}-vat-error {{ prefix }}-vat-hint" class="input-field uppercase placeholder:normal-case">
  <p id="{{ prefix }}-vat-error" data-error-for="vat" hidden class="{{ error_class }}"></p>
  <p id="{{ prefix }}-vat-hint" class="mt-1 text-xs text-[var(--color-charcoal-soft)]">{{ 'np.b2b_auth.vat_hint' | t }}</p>
</div>

{%- if with_password -%}
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="{{ prefix }}-password" class="{{ label_class }}">{{ 'np.b2b_auth.password' | t }}</label>
      <input id="{{ prefix }}-password" name="password" data-field="password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" aria-describedby="{{ prefix }}-password-error {{ prefix }}-password-hint" class="input-field">
      <p id="{{ prefix }}-password-error" data-error-for="password" hidden class="{{ error_class }}"></p>
    </div>
    <div>
      <label for="{{ prefix }}-password2" class="{{ label_class }}">{{ 'np.b2b_auth.password_confirm' | t }}</label>
      <input id="{{ prefix }}-password2" name="passwordConfirm" data-field="passwordConfirm" type="password" required minlength="8" maxlength="128" autocomplete="new-password" aria-describedby="{{ prefix }}-password2-error" class="input-field">
      <p id="{{ prefix }}-password2-error" data-error-for="passwordConfirm" hidden class="{{ error_class }}"></p>
    </div>
  </div>
  <p id="{{ prefix }}-password-hint" class="-mt-2 text-xs text-[var(--color-charcoal-soft)]">{{ 'np.b2b_auth.password_hint' | t }}</p>
{%- endif -%}
