{%- comment -%}
  B2B shipping promotion "every pallet only 100 €". Rendered only where pallet shipping is really charged (B2B customer
  + verification service configured - see np-cart / np-header); hidden by naturepick.js while the B2B customer views
  regular prices (data-b2b-pallet-only), because that checkout is Shopify's ordinary one.
  The price is shown in the visitor's currency: Liquid renders the configured price, naturepick.js swaps in the price
  converted by the verification service (data-pallet-price-template, %PRICE%) - the amount the checkout charges.
  Params: cart, style ('bar' = one line in the header announcement bar, 'card' = box on the cart page)
{%- endcomment -%}
{%- liquid
  capture price_parts
    render 'np-b2b-pallet-price', cart: cart
  endcapture
  assign price_parts = price_parts | strip | split: ':'
  assign price_text = price_parts[2]
  assign headline_template = 'np.b2b_pallets.promo_headline' | t: price: '%PRICE%'
  assign text_template = 'np.b2b_pallets.promo_text' | t: price: '%PRICE%'
-%}
{%- if style == 'bar' -%}
  <div class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-xs sm:justify-start sm:text-sm" data-b2b-pallet-only data-b2b-pallet-promo>
    <button type="button" data-open-b2b-modal class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-gold)]/60 bg-[var(--color-gold)]/15 px-3 py-0.5 text-[11px] font-bold uppercase tracking-wider text-[var(--color-gold)] shadow-sm transition hover:bg-[var(--color-gold)]/30">
      <span>{{ 'np.b2b_pallets.promo_title' | t }}</span>
    </button>
    <span class="font-bold text-white sm:text-sm" data-pallet-price-template="{{ headline_template | escape }}">
      {{ 'np.b2b_pallets.promo_headline' | t: price: price_text }}
    </span>
    <button type="button" data-open-b2b-modal class="hidden font-semibold text-[var(--color-gold)] underline decoration-[var(--color-gold)]/50 underline-offset-2 transition hover:text-yellow-300 md:inline">
      {{ 'np.b2b_pallets.promo_learn_more' | t }}
    </button>
  </div>
{%- else -%}
  <div class="rounded-2xl border border-[var(--color-gold)]/50 bg-[#141b16] p-5 text-white shadow-lg" data-b2b-pallet-only data-b2b-pallet-promo>
    <div class="flex items-center justify-between gap-2">
      <span class="inline-flex rounded-full border border-[var(--color-gold)]/50 bg-[var(--color-gold)]/15 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[var(--color-gold)]">{{ 'np.b2b_pallets.promo_title' | t }}</span>
      <button type="button" data-open-b2b-modal class="text-xs font-semibold text-[var(--color-gold)] underline decoration-[var(--color-gold)]/40 underline-offset-2 transition hover:text-yellow-300">
        {{ 'np.b2b_pallets.promo_learn_more' | t }}
      </button>
    </div>
    <p class="mt-3 font-display text-lg font-bold text-white sm:text-xl" data-pallet-price-template="{{ headline_template | escape }}">{{ 'np.b2b_pallets.promo_headline' | t: price: price_text }}</p>
  </div>
{%- endif -%}
