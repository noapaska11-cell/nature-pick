{%- comment -%}
  B2B shipping promotion "every pallet only 100 €". Rendered only where pallet shipping is really charged (B2B customer
  + verification service configured - see np-cart / np-header); hidden by naturepick.js while the B2B customer views
  regular prices (data-b2b-pallet-only), because that checkout is Shopify's ordinary one.
  The price is shown in the visitor's currency: Liquid renders the configured price, naturepick.js swaps in the price
  converted by the verification service (data-pallet-price-template, %PRICE%) - the amount the checkout charges.
  Params: cart, style ('bar' = one line in the header announcement bar, 'card' = box on the cart page)
{%- endcomment -%}
{%- liquid
  capture price_parts
    render 'np-b2b-pallet-price', cart: cart
  endcapture
  assign price_parts = price_parts | strip | split: ':'
  assign price_text = price_parts[2]
  assign headline_template = 'np.b2b_pallets.promo_headline' | t: price: '%PRICE%'
  assign text_template = 'np.b2b_pallets.promo_text' | t: price: '%PRICE%'
-%}
{%- if style == 'bar' -%}
  <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-0.5 text-xs sm:justify-start sm:text-sm" data-b2b-pallet-only data-b2b-pallet-promo>
    <span class="inline-flex rounded-full bg-[var(--color-gold)] px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-[var(--color-charcoal)] shadow-sm">
      🚚 {{ 'np.b2b_pallets.promo_title' | t }}
    </span>
    <span class="font-semibold text-white" data-pallet-price-template="{{ headline_template | escape }}">
      {{ 'np.b2b_pallets.promo_headline' | t: price: price_text }}
    </span>
    <span class="hidden opacity-90 md:inline" data-pallet-price-template="{{ text_template | escape }}">
      — {{ 'np.b2b_pallets.promo_text' | t: price: price_text }}
    </span>
  </div>
{%- else -%}
  <div class="rounded-2xl border border-[var(--color-gold)]/40 bg-[var(--color-olive-light)] p-4 text-[var(--color-olive-dark)] shadow-sm" data-b2b-pallet-only data-b2b-pallet-promo>
    <div class="flex items-center gap-2">
      <span class="inline-flex rounded-full bg-[var(--color-gold)] px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-[var(--color-charcoal)]">{{ 'np.b2b_pallets.promo_title' | t }}</span>
    </div>
    <p class="mt-2 font-display text-lg font-bold text-[var(--color-charcoal)]" data-pallet-price-template="{{ headline_template | escape }}">{{ 'np.b2b_pallets.promo_headline' | t: price: price_text }}</p>
    <p class="mt-1 text-sm leading-relaxed text-[var(--color-charcoal-soft)]" data-pallet-price-template="{{ text_template | escape }}">{{ 'np.b2b_pallets.promo_text' | t: price: price_text }}</p>
  </div>
{%- endif -%}
