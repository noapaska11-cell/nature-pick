{%- comment -%}
  Star rating row. Ratings come from the standard Shopify review metafields
  (reviews.rating / reviews.rating_count, written by Shopify Product Reviews, Judge.me, Loox, ...).
  Nothing is rendered when the product has no reviews - the Next.js placeholder ratings are gone.

  Params: product, class (icon size, default 'h-3.5 w-3.5'), show_label ('count' | 'full'), label_class
{%- endcomment -%}
{%- liquid
  assign rating_object = product.metafields.reviews.rating.value
  assign rating_value = rating_object.rating | plus: 0
  assign rating_count = product.metafields.reviews.rating_count.value | plus: 0
  assign star_class = class | default: 'h-3.5 w-3.5'
  assign rounded = rating_value | round
-%}
{%- if rating_value > 0 -%}
  <div class="flex items-center gap-1 text-[var(--color-gold)]" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_object.scale_max }}">
    {%- for i in (1..5) -%}
      {%- if i <= rounded -%}
        {% render 'icon', name: 'star', class: star_class %}
      {%- else -%}
        {% render 'icon', name: 'star-outline', class: star_class %}
      {%- endif -%}
    {%- endfor -%}
    {%- if show_label == 'full' -%}
      <span class="ml-1 text-sm text-[var(--color-charcoal-soft)]">{{ rating_value | round: 1 }} · {{ rating_count }} {{ 'np.common.reviews' | t }}</span>
    {%- elsif rating_count > 0 -%}
      <span class="ml-1 text-xs text-[var(--color-charcoal-soft)]">({{ rating_count }})</span>
    {%- endif -%}
  </div>
{%- endif -%}
