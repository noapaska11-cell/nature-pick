{%- comment -%}
  B2B cart summary (cart page + cart drawer) = what the B2B checkout charges: subtotal at the price list (excl. VAT),
  pallet shipping, VAT (added by Shopify at checkout - 0 for a tax-exempt company) and the total. Shopify's own cart
  total is the regular prices, so it is deliberately not shown to a B2B customer. Amounts in a currency other than the
  shop's are filled in by naturepick.js (syncB2bSummary); the shipping and the total once the pallet price is known.
  Only rendered where the B2B checkout runs (B2B customer + verification service, see np-cart.liquid). Params: cart
{%- endcomment -%}
{%- liquid
  capture wholesale_parts
    render 'np-b2b-cart-wholesale', cart: cart
  endcapture
  assign wholesale_parts = wholesale_parts | strip | split: ':'
  assign listed_cents = wholesale_parts[0] | plus: 0
  assign other_cents = wholesale_parts[1] | plus: 0
  assign wholesale_cents = listed_cents | plus: other_cents
  assign subtotal_text = ''
  if cart.currency.iso_code == shop.currency
    assign subtotal_text = wholesale_cents | money_without_trailing_zeros
  endif
  assign tax_exempt = customer.tax_exempt
  if tax_exempt
    assign total_label = 'np.price.total_due' | t
  else
    assign total_label = 'np.price.total_excl_vat' | t
  endif
-%}
<div class="np-summary" data-b2b-summary data-b2b-wholesale-total data-wholesale-listed="{{ listed_cents }}" data-wholesale-other="{{ other_cents }}">
  <div class="np-summary__row">
    <span>{{ 'np.price.subtotal_b2b' | t }} <span class="np-summary__vat">{{ 'np.price.excl_vat' | t }}</span></span>
    <span class="np-summary__value" data-b2b-wholesale-total-value>{{ subtotal_text }}</span>
  </div>
  {%- if other_cents > 0 -%}
    <p class="np-summary__note">{{ 'np.price.other_lines_note' | t }}</p>
  {%- endif -%}
  <div class="np-summary__block">{% render 'np-b2b-pallet-summary', cart: cart %}</div>
  <div class="np-summary__row">
    <span>{{ 'np.price.vat' | t }}</span>
    <span class="np-summary__value">{% if tax_exempt %}{{ 0 | money_without_trailing_zeros }}{% else %}{{ 'np.price.vat_at_checkout' | t }}{% endif %}</span>
  </div>
  <div class="np-summary__total">
    <span>{{ total_label }}</span>
    <span class="np-summary__total-value"><span data-b2b-grand-total>{{ subtotal_text }}</span> <span class="np-summary__plus" data-b2b-grand-plus>{{ 'np.price.plus_shipping' | t }}</span></span>
  </div>
  <p class="np-summary__note">
    {%- if tax_exempt -%}
      {{ 'np.price.vat_exempt_note' | t }}
    {%- elsif cart.taxes_included -%}
      {{ 'np.price.vat_note_gross' | t }}
    {%- else -%}
      {{ 'np.price.vat_note' | t }}
    {%- endif -%}
  </p>
</div>
