{%- comment -%}
  Product / collection image with the same treatment as the React <ProductImage />:
  white background, object-cover, slow zoom on hover (parent needs the "group" class).
  Falls back to a gradient tile with an icon (<ProductVisual />) when there is no image.

  Params:
    image    - image or media object (product.featured_media works too)
    alt      - alt text
    class    - classes for the wrapper (size / aspect ratio / rounding)
    sizes    - sizes attribute
    widths   - srcset widths, default '240, 360, 540, 720, 960, 1200'
    eager    - true for above-the-fold images
    index    - number used to pick the fallback gradient
    icon     - fallback icon name (default 'leaf')
{%- endcomment -%}
{%- liquid
  assign img_widths = widths | default: '240, 360, 540, 720, 960, 1200'
  assign img_sizes = sizes | default: '(min-width: 1024px) 25vw, 50vw'
  assign fallback_icon = icon | default: 'leaf'
  assign gradient_index = index | default: 0 | modulo: 8
-%}
{%- if image != blank -%}
  <div class="relative overflow-hidden bg-white {{ class }}">
    {%- if eager -%}
      {{ image | image_url: width: 1200 | image_tag: widths: img_widths, sizes: img_sizes, alt: alt, loading: 'eager', fetchpriority: 'high', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105' }}
    {%- else -%}
      {{ image | image_url: width: 1200 | image_tag: widths: img_widths, sizes: img_sizes, alt: alt, loading: 'lazy', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105' }}
    {%- endif -%}
  </div>
{%- else -%}
  {%- liquid
    case gradient_index
      when 0
        assign gradient = 'from-[#e9c9a1] to-[#c98a4b]'
      when 1
        assign gradient = 'from-[#f3b58a] to-[#c1440e]'
      when 2
        assign gradient = 'from-[#e6a9a0] to-[#a94b3a]'
      when 3
        assign gradient = 'from-[#f0b57e] to-[#c1440e]'
      when 4
        assign gradient = 'from-[#d8c98a] to-[#8a7a2e]'
      when 5
        assign gradient = 'from-[#c3d2a0] to-[#4f5e33]'
      when 6
        assign gradient = 'from-[#e3c8a8] to-[#8a5a2e]'
      else
        assign gradient = 'from-[#d7c39a] to-[#4f5e33]'
    endcase
  -%}
  <div class="relative flex items-center justify-center overflow-hidden bg-gradient-to-br {{ gradient }} {{ class }}" role="img" aria-label="{{ alt | escape }}">
    <div class="absolute inset-0 opacity-15 mix-blend-overlay [background-image:radial-gradient(circle_at_20%_20%,white,transparent_35%),radial-gradient(circle_at_80%_70%,white,transparent_40%)]"></div>
    {% render 'icon', name: fallback_icon, class: 'h-14 w-14 text-white/90 drop-shadow-sm transition-transform duration-500 ease-out group-hover:scale-110', stroke: 1.3 %}
  </div>
{%- endif -%}
