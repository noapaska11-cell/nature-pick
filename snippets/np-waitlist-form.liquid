{%- comment -%}
  Waiting-list sign-up (React <WaitlistForm />). Native Shopify customer form: subscribers are created
  in Shopify > Customers with the tag "spice-club". Param: form_id, tag
{%- endcomment -%}
{%- liquid
  assign wl_id = form_id | default: 'WaitlistForm'
  assign wl_tag = tag | default: 'spice-club'
-%}
{%- form 'customer', id: wl_id, class: 'contents' -%}
  <input type="hidden" name="contact[tags]" value="{{ wl_tag }}">
  {%- if form.posted_successfully? -%}
    <p class="flex items-center justify-center gap-2 rounded-full bg-[var(--color-olive-light)] px-4 py-3 text-sm font-medium text-[var(--color-olive-dark)]" role="status">
      {% render 'icon', name: 'check', class: 'h-4 w-4' %} {{ 'np.waitlist_form.confirmed' | t }}
    </p>
  {%- else -%}
    <div class="flex items-center gap-1 rounded-full border border-[var(--color-line)] bg-[var(--color-paper)] p-1">
      <label for="{{ wl_id }}-email" class="sr-only">{{ 'np.common.email' | t }}</label>
      <input
        id="{{ wl_id }}-email"
        type="email"
        name="contact[email]"
        required
        autocomplete="email"
        value="{{ form.email }}"
        placeholder="{{ 'np.waitlist_form.placeholder' | t }}"
        class="w-full flex-1 rounded-full bg-transparent px-3 py-2.5 text-sm text-[var(--color-charcoal)] outline-none placeholder:text-[var(--color-charcoal-soft)] focus-visible:ring-2 focus-visible:ring-[var(--color-paprika)]"
      >
      <button type="submit" class="btn-primary flex-shrink-0 !py-2.5">{{ 'np.waitlist_form.submit' | t }}</button>
    </div>
    {%- if form.errors -%}
      <div class="mt-2 text-xs text-[var(--color-paprika-dark)]" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
  {%- endif -%}
{%- endform -%}
