{%- comment -%}
  Breadcrumb + title band used at the top of content pages (React <PageHero />).
  Params: eyebrow (breadcrumb label), title, description (optional)
{%- endcomment -%}
<section class="border-b border-[var(--color-line)] bg-[var(--color-cream-soft)]">
  <div class="container-page py-12">
    <nav class="mb-3 flex items-center gap-1.5 text-xs text-[var(--color-charcoal-soft)]" aria-label="{{ 'np.common.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}" class="hover:text-[var(--color-paprika-dark)]">{{ 'np.common.home' | t }}</a>
      {% render 'icon', name: 'chevron-right', class: 'h-3 w-3' %}
      <span>{{ eyebrow }}</span>
    </nav>
    <h1 class="font-display text-3xl font-semibold text-[var(--color-charcoal)] sm:text-4xl">{{ title }}</h1>
    {%- if description != blank -%}
      <p class="mt-3 max-w-2xl leading-relaxed text-[var(--color-charcoal-soft)]">{{ description }}</p>
    {%- endif -%}
  </div>
</section>
