{%- comment -%}Emoji flag for a language iso code (same set + look as the Next.js language switcher). Param: code{%- endcomment -%}
{%- liquid
  assign flag_code = code | split: '-' | first | downcase
  case flag_code
    when 'pl'
      echo '🇵🇱'
    when 'sv'
      echo '🇸🇪'
    when 'en'
      echo '🇬🇧'
    when 'hr'
      echo '🇭🇷'
    when 'de'
      echo '🇩🇪'
    when 'da'
      echo '🇩🇰'
    when 'fi'
      echo '🇫🇮'
    when 'nb', 'no', 'nn'
      echo '🇳🇴'
    when 'fr'
      echo '🇫🇷'
    when 'nl'
      echo '🇳🇱'
    when 'it'
      echo '🇮🇹'
    when 'es'
      echo '🇪🇸'
    when 'pt'
      echo '🇵🇹'
    when 'cs'
      echo '🇨🇿'
    when 'sk'
      echo '🇸🇰'
    when 'sl'
      echo '🇸🇮'
    when 'hu'
      echo '🇭🇺'
    when 'ro'
      echo '🇷🇴'
    when 'bg'
      echo '🇧🇬'
    when 'el'
      echo '🇬🇷'
    when 'lt'
      echo '🇱🇹'
    when 'lv'
      echo '🇱🇻'
    when 'et'
      echo '🇪🇪'
    when 'tr'
      echo '🇹🇷'
    when 'uk'
      echo '🇺🇦'
    when 'ru'
      echo '🇷🇺'
    else
      echo '🌐'
  endcase
-%}
