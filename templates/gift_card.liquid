{% layout none %}
{%- comment -%}Gift card page shown to the recipient. Standalone document (no header/footer).{%- endcomment -%}
<!doctype html>
<html class="scroll-smooth" lang="{{ request.locale.iso_code }}">
  <head>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_cream }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">
    {{ content_for_header }}
    {%- render 'np-head-styles' -%}
    <style>
      @media print { .no-print { display: none !important; } }
    </style>
  </head>

  <body class="flex min-h-full flex-col items-center bg-[var(--color-cream)] px-4 py-12 antialiased">
    <header class="text-center">
      <h1 class="font-display text-5xl font-semibold text-[var(--color-charcoal)]">{{ gift_card.balance | money_with_currency }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="mt-3 inline-block rounded-full bg-[var(--color-paprika-light)] px-3 py-1 text-xs font-semibold text-[var(--color-paprika-dark)]">{{ 'gift_cards.issued.expired' | t }}</p>
      {%- endif -%}
      {%- if gift_card.expires_on -%}
        {%- assign gift_card_expiration_date = gift_card.expires_on | date: '%B %e, %Y' -%}
        <p class="mt-2 text-sm text-[var(--color-charcoal-soft)]">{{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card_expiration_date }}</p>
      {%- endif -%}
    </header>

    <main class="card-surface mt-8 flex w-full max-w-md flex-col items-center gap-4 p-8 text-center">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, class: 'h-20 w-auto object-contain' }}
      {%- else -%}
        <img src="{{ 'np-logo.webp' | asset_url }}" width="600" height="600" alt="{{ shop.name | escape }}" class="h-20 w-auto object-contain">
      {%- endif -%}
      <h2 class="font-display text-xl font-semibold text-[var(--color-charcoal)]">{{ shop.name }}</h2>
      <p class="text-sm text-[var(--color-charcoal-soft)]">{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
      <p id="gift-card-code" class="rounded-xl bg-[var(--color-cream-soft)] px-5 py-3 font-mono text-lg font-semibold tracking-widest text-[var(--color-charcoal)]">{{ gift_card.code | format_code }}</p>
      <div class="gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="no-print">
          <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy">
        </a>
      {%- endif -%}
      <div class="no-print mt-2 flex flex-wrap items-center justify-center gap-3">
        <button type="button" class="btn-primary gift-card__copy-button">{{ 'gift_cards.issued.copy_code' | t }}</button>
        <a href="{{ shop.url }}" class="btn-secondary" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a>
      </div>
      <p class="gift-card__copy-success min-h-5 text-sm font-medium text-[var(--color-olive-dark)]" role="status"></p>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qr = document.querySelector('.gift-card__qr-code');
        if (qr && typeof QRCode !== 'undefined') {
          new QRCode(qr, { text: qr.dataset.identifier, width: 72, height: 72, imageAltText: {{ 'gift_cards.issued.qr_image_alt' | t | json }} });
        }
        var copyButton = document.querySelector('.gift-card__copy-button');
        var message = document.querySelector('.gift-card__copy-success');
        copyButton.addEventListener('click', function () {
          navigator.clipboard.writeText(document.getElementById('gift-card-code').innerText).then(function () {
            message.textContent = {{ 'gift_cards.issued.copy_code_success' | t | json }};
          });
        });
      });
    </script>
  </body>
</html>
