{%- comment -%}
  Customer login + password recovery (classic customer accounts). With the "new customer accounts"
  Shopify hosts login itself and never renders this template.
{%- endcomment -%}
<div class="container-page py-14">
  <div class="mx-auto max-w-md">
    {%- assign recover_open = false -%}
    {%- if request.path contains 'recover' -%}{%- assign recover_open = true -%}{%- endif -%}

    <div data-login-panel {% if recover_open %}hidden{% endif %}>
      <h1 class="font-display text-3xl font-semibold text-[var(--color-charcoal)]">{{ 'customer.login_page.title' | t }}</h1>

      {%- form 'customer_login', novalidate: 'novalidate', class: 'mt-6 flex flex-col gap-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6' -%}
        {%- if form.errors -%}
          <div class="rounded-xl bg-[var(--color-paprika-light)] px-4 py-3 text-sm text-[var(--color-paprika-dark)]" role="alert">
            <p class="mb-1 flex items-center gap-1.5 font-semibold">{% render 'icon', name: 'alert', class: 'h-4 w-4' %} {{ 'templates.contact.form.error_heading' | t }}</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        {% render 'np-field', id: 'CustomerEmail', name: 'customer[email]', type: 'email', label_key: 'customer.login_page.email', autocomplete: 'email', required: true, autofocus: true %}
        {%- if form.password_needed -%}
          {% render 'np-field', id: 'CustomerPassword', name: 'customer[password]', type: 'password', label_key: 'customer.login_page.password', autocomplete: 'current-password', required: true %}
          <button type="button" data-toggle-recover class="self-start text-sm text-[var(--color-paprika-dark)] underline">{{ 'customer.login_page.forgot_password' | t }}</button>
        {%- endif -%}
        <button type="submit" class="btn-primary">{{ 'customer.login_page.sign_in' | t }}</button>
        <a href="{{ routes.account_register_url }}" class="text-center text-sm text-[var(--color-charcoal-soft)] underline hover:text-[var(--color-charcoal)]">{{ 'customer.login_page.create_account' | t }}</a>
      {%- endform -%}

      {%- if shop.checkout.guest_login -%}
        <div class="mt-8">
          <h2 class="font-display text-lg font-semibold text-[var(--color-charcoal)]">{{ 'customer.login_page.guest_title' | t }}</h2>
          {%- form 'guest_login', class: 'mt-3' -%}
            <button type="submit" class="btn-secondary">{{ 'customer.login_page.guest_continue' | t }}</button>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div data-recover-panel {% unless recover_open %}hidden{% endunless %}>
      <h1 class="font-display text-3xl font-semibold text-[var(--color-charcoal)]">{{ 'customer.recover_password.title' | t }}</h1>
      <p class="mt-2 text-sm text-[var(--color-charcoal-soft)]">{{ 'customer.recover_password.subtext' | t }}</p>
      {%- form 'recover_customer_password', novalidate: 'novalidate', class: 'mt-6 flex flex-col gap-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6' -%}
        {%- if form.posted_successfully? -%}
          <p class="flex items-center gap-2 rounded-xl bg-[var(--color-olive-light)] px-4 py-3 text-sm font-medium text-[var(--color-olive-dark)]" role="status">
            {% render 'icon', name: 'check', class: 'h-4 w-4' %} {{ 'customer.recover_password.success' | t }}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="rounded-xl bg-[var(--color-paprika-light)] px-4 py-3 text-sm text-[var(--color-paprika-dark)]" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {% render 'np-field', id: 'RecoverEmail', name: 'email', type: 'email', label_key: 'customer.login_page.email', autocomplete: 'email', required: true %}
        <button type="submit" class="btn-primary">{{ 'customer.login_page.submit' | t }}</button>
        <button type="button" data-toggle-recover class="text-sm text-[var(--color-charcoal-soft)] underline hover:text-[var(--color-charcoal)]">{{ 'customer.login_page.cancel' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Login",
  "enabled_on": {
    "templates": ["customers/login"]
  }
}
{% endschema %}
