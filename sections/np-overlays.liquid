{%- comment -%}
  Global overlays: search modal, quick-view modal shell, cart toast, cookie banner, quick-contact
  widget and site-wide structured data. Rendered once via footer-group.json (not a layout render
  or a standalone snippet - Shopify's GitHub sync would not resolve either of those for this
  content under any filename, even though it was verifiably present on GitHub every time; groups
  of sections referenced from header-group.json/footer-group.json have synced reliably throughout).
{%- endcomment -%}

{%- comment -%} Search modal (predictive search) {%- endcomment -%}
<div id="np-search" hidden class="fixed inset-0 z-50 flex items-start justify-center p-4 pt-20 sm:pt-28" data-search-modal>
  <div class="absolute inset-0 bg-black/40" data-search-close aria-hidden="true"></div>
  <div role="dialog" aria-modal="true" aria-label="{{ 'np.search.open_aria' | t }}" class="relative flex max-h-[70vh] w-full max-w-xl flex-col overflow-hidden rounded-3xl bg-[var(--color-paper)] shadow-2xl">
    <form action="{{ routes.search_url }}" method="get" role="search" class="flex items-center gap-3 border-b border-[var(--color-line)] px-5 py-4">
      {% render 'icon', name: 'search', class: 'h-5 w-5 flex-shrink-0 text-[var(--color-charcoal-soft)]' %}
      <input type="hidden" name="options[prefix]" value="last">
      <input
        type="search"
        name="q"
        data-search-input
        autocomplete="off"
        placeholder="{{ 'np.search.placeholder' | t }}"
        aria-label="{{ 'np.search.placeholder' | t }}"
        class="w-full flex-1 bg-transparent text-base text-[var(--color-charcoal)] outline-none placeholder:text-[var(--color-charcoal-soft)]"
      >
      <button type="button" data-search-close aria-label="{{ 'np.search.close_aria' | t }}" class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full text-[var(--color-charcoal-soft)] hover:bg-[var(--color-cream-soft)] hover:text-[var(--color-charcoal)]">
        {% render 'icon', name: 'close', class: 'h-4 w-4' %}
      </button>
    </form>
    <div data-search-results class="flex-1 overflow-y-auto p-2" hidden aria-live="polite"></div>
  </div>
</div>

{%- comment -%} Quick view modal shell (content is fetched from the np-quick-view section) {%- endcomment -%}
<div id="np-quick-view" hidden class="fixed inset-0 z-50 flex items-center justify-center p-4" data-quick-view-modal>
  <div class="absolute inset-0 bg-black/40" data-quick-view-close aria-hidden="true"></div>
  <div data-quick-view-content class="relative w-full max-w-2xl"></div>
</div>

{%- comment -%} Add-to-cart toast {%- endcomment -%}
<div id="np-toast" aria-live="polite" class="np-toast fixed bottom-24 left-1/2 z-50 w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 sm:bottom-6 sm:left-auto sm:right-6 sm:translate-x-0" data-toast></div>

{%- comment -%} Cookie banner: uses Shopify's Customer Privacy API when available {%- endcomment -%}
{%- if settings.enable_cookie_banner -%}
  {%- assign privacy_link = shop.privacy_policy.url | default: routes.root_url -%}
  <div id="np-cookie" hidden class="fixed inset-x-0 bottom-0 z-[60] border-t border-[var(--color-line)] bg-[var(--color-paper)] px-4 py-4 shadow-[0_-8px_24px_rgba(0,0,0,0.08)] sm:px-6" role="region" aria-label="{{ 'np.cookie_consent.accept_all' | t }}" data-cookie-banner>
    <div class="container-page flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <div class="flex items-start gap-3">
        {% render 'icon', name: 'shield', class: 'mt-0.5 h-5 w-5 flex-shrink-0 text-[var(--color-olive-dark)]' %}
        <p class="text-sm leading-relaxed text-[var(--color-charcoal-soft)]">
          {{ 'np.cookie_consent.text_html' | t: privacy_url: privacy_link }}
        </p>
      </div>
      <div class="flex flex-shrink-0 gap-2">
        <button type="button" data-cookie-choice="rejected" class="btn-secondary text-sm">{{ 'np.cookie_consent.reject_all' | t }}</button>
        <button type="button" data-cookie-choice="accepted" class="btn-primary text-sm">{{ 'np.cookie_consent.accept_all' | t }}</button>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} Quick contact widget {%- endcomment -%}
{%- if settings.enable_quick_contact -%}
  <div class="fixed bottom-24 left-6 z-40 sm:bottom-6" data-quick-contact>
    <div hidden data-quick-contact-panel class="absolute bottom-14 left-0 w-72 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-4 shadow-xl shadow-black/10">
      <p class="font-display text-base font-semibold text-[var(--color-charcoal)]">{{ 'np.quick_contact.title' | t }}</p>
      <p class="mt-1 text-xs text-[var(--color-charcoal-soft)]">{{ 'np.quick_contact.subtitle' | t }}</p>
      <div class="mt-3 flex flex-col gap-2">
        {%- if pages.contact != blank -%}
          <a href="{{ pages.contact.url }}" class="flex items-center justify-between rounded-xl border border-[var(--color-line)] px-3 py-2.5 text-sm font-medium text-[var(--color-charcoal)] hover:border-[var(--color-paprika)]">
            {{ 'np.quick_contact.send_message' | t }} {% render 'icon', name: 'arrow-right', class: 'h-3.5 w-3.5' %}
          </a>
        {%- endif -%}
        {%- if pages.faq != blank -%}
          <a href="{{ pages.faq.url }}" class="flex items-center justify-between rounded-xl border border-[var(--color-line)] px-3 py-2.5 text-sm font-medium text-[var(--color-charcoal)] hover:border-[var(--color-paprika)]">
            {{ 'np.quick_contact.faq' | t }} {% render 'icon', name: 'arrow-right', class: 'h-3.5 w-3.5' %}
          </a>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <a href="mailto:{{ settings.contact_email }}" class="flex items-center gap-2 px-1 pt-1 text-xs text-[var(--color-charcoal-soft)] hover:text-[var(--color-paprika-dark)]">
            {% render 'icon', name: 'mail', class: 'h-3.5 w-3.5' %} {{ settings.contact_email }}
          </a>
        {%- endif -%}
      </div>
    </div>
    <button
      type="button"
      data-quick-contact-toggle
      aria-expanded="false"
      aria-label="{{ 'np.quick_contact.open_aria' | t }}"
      data-label-open="{{ 'np.quick_contact.open_aria' | t }}"
      data-label-close="{{ 'np.quick_contact.close_aria' | t }}"
      class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-charcoal)] text-white shadow-lg shadow-black/20 transition-transform hover:scale-105"
    >
      <span data-icon-open>{% render 'icon', name: 'chat', class: 'h-5 w-5' %}</span>
      <span data-icon-close hidden>{% render 'icon', name: 'close', class: 'h-5 w-5' %}</span>
    </button>
  </div>
{%- endif -%}

{%- comment -%} Structured data (home page only, like a single Organization/WebSite declaration) {%- endcomment -%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {%- if settings.logo != blank -%}
      "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif -%}
      "contactPoint": {
        "@type": "ContactPoint",
        "email": {{ settings.contact_email | json }},
        "contactType": "customer service"
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": {{ settings.company_name | json }},
        "address": {{ settings.company_address | json }}
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Overlays"
}
{% endschema %}
