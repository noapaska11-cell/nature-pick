<div class="container-page py-14">
  <a href="{{ routes.account_url }}" class="inline-flex items-center gap-1 text-sm text-[var(--color-charcoal-soft)] hover:text-[var(--color-charcoal)]">
    {% render 'icon', name: 'chevron-left', class: 'h-4 w-4' %} {{ 'customer.account.return' | t }}
  </a>

  <h1 class="mt-4 font-display text-3xl font-semibold text-[var(--color-charcoal)]">{{ 'customer.order.title' | t: name: order.name }}</h1>
  {%- assign order_date = order.created_at | time_tag: format: 'date' -%}
  <p class="mt-1 text-sm text-[var(--color-charcoal-soft)]">{{ 'customer.order.date_html' | t: date: order_date }}</p>
  {%- if order.cancelled -%}
    {%- assign cancelled_at = order.cancelled_at | time_tag: format: 'date' -%}
    <p class="mt-3 rounded-xl bg-[var(--color-paprika-light)] px-4 py-3 text-sm text-[var(--color-paprika-dark)]">
      {{ 'customer.order.cancelled_html' | t: date: cancelled_at }} · {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
    </p>
  {%- endif -%}

  <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_20rem]">
    <div>
      <div class="overflow-x-auto rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)]">
        <table class="w-full min-w-[520px] text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--color-line)] bg-[var(--color-cream-soft)]">
              <th class="px-4 py-2.5 font-medium text-[var(--color-charcoal)]">{{ 'customer.order.product' | t }}</th>
              <th class="px-4 py-2.5 font-medium text-[var(--color-charcoal)]">{{ 'customer.order.price' | t }}</th>
              <th class="px-4 py-2.5 font-medium text-[var(--color-charcoal)]">{{ 'customer.order.quantity' | t }}</th>
              <th class="px-4 py-2.5 text-right font-medium text-[var(--color-charcoal)]">{{ 'customer.order.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for line_item in order.line_items -%}
              <tr class="border-b border-[var(--color-line)] last:border-0 align-top">
                <td class="px-4 py-3">
                  {%- if line_item.url != blank -%}
                    <a href="{{ line_item.url }}" class="font-medium text-[var(--color-charcoal)] hover:text-[var(--color-paprika-dark)]">{{ line_item.title | escape }}</a>
                  {%- else -%}
                    <span class="font-medium text-[var(--color-charcoal)]">{{ line_item.title | escape }}</span>
                  {%- endif -%}
                  {%- if line_item.sku != blank -%}
                    <p class="text-xs text-[var(--color-charcoal-soft)]">{{ 'customer.order.sku' | t }}: {{ line_item.sku }}</p>
                  {%- endif -%}
                  {%- for allocation in line_item.line_level_discount_allocations -%}
                    <p class="text-xs text-[var(--color-olive-dark)]">{{ allocation.discount_application.title | escape }} (-{{ allocation.amount | money }})</p>
                  {%- endfor -%}
                  {%- if line_item.fulfillment -%}
                    <p class="mt-1 text-xs text-[var(--color-charcoal-soft)]">
                      {%- assign fulfilled_date = line_item.fulfillment.created_at | time_tag: format: 'date' -%}
                      {{ 'customer.order.fulfilled_at_html' | t: date: fulfilled_date }}
                      {%- if line_item.fulfillment.tracking_url != blank -%}
                        · <a href="{{ line_item.fulfillment.tracking_url }}" class="underline hover:text-[var(--color-charcoal)]">{{ 'customer.order.track_shipment' | t }}</a>
                      {%- endif -%}
                    </p>
                    {%- if line_item.fulfillment.tracking_company != blank or line_item.fulfillment.tracking_number != blank -%}
                      <p class="text-xs text-[var(--color-charcoal-soft)]">{{ line_item.fulfillment.tracking_company }} {{ line_item.fulfillment.tracking_number }}</p>
                    {%- endif -%}
                  {%- endif -%}
                </td>
                <td class="px-4 py-3 text-[var(--color-charcoal-soft)]">{{ line_item.original_price | money }}</td>
                <td class="px-4 py-3 text-[var(--color-charcoal-soft)]">{{ line_item.quantity }}</td>
                <td class="px-4 py-3 text-right font-medium text-[var(--color-charcoal)]">{{ line_item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <dl class="mt-6 ml-auto flex max-w-xs flex-col gap-2 text-sm text-[var(--color-charcoal-soft)]">
        <div class="flex justify-between"><dt>{{ 'customer.order.subtotal' | t }}</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>
        {%- for discount in order.cart_level_discount_applications -%}
          <div class="flex justify-between text-[var(--color-olive-dark)]"><dt>{{ discount.title | escape }}</dt><dd>-{{ discount.total_allocated_amount | money }}</dd></div>
        {%- endfor -%}
        {%- for shipping_method in order.shipping_methods -%}
          <div class="flex justify-between"><dt>{{ 'customer.order.shipping' | t }} ({{ shipping_method.title | escape }})</dt><dd>{{ shipping_method.price | money }}</dd></div>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <div class="flex justify-between"><dt>{{ 'customer.order.tax' | t }} ({{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%)</dt><dd>{{ tax_line.price | money }}</dd></div>
        {%- endfor -%}
        {%- if order.total_duties -%}
          <div class="flex justify-between"><dt>{{ 'customer.order.total_duties' | t }}</dt><dd>{{ order.total_duties | money }}</dd></div>
        {%- endif -%}
        <div class="flex justify-between border-t border-[var(--color-line)] pt-3 font-display text-lg font-semibold text-[var(--color-charcoal)]"><dt>{{ 'customer.order.total' | t }}</dt><dd>{{ order.total_price | money_with_currency }}</dd></div>
        {%- if order.total_refunded_amount > 0 -%}
          <div class="flex justify-between"><dt>{{ 'customer.order.total_refunded' | t }}</dt><dd>-{{ order.total_refunded_amount | money }}</dd></div>
        {%- endif -%}
      </dl>
    </div>

    <aside class="flex h-fit flex-col gap-6 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6 text-sm text-[var(--color-charcoal-soft)]">
      <div>
        <h2 class="font-display text-base font-semibold text-[var(--color-charcoal)]">{{ 'customer.order.billing_address' | t }}</h2>
        <p class="mt-1 text-xs">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
        <div class="mt-2 leading-relaxed">{{ order.billing_address | format_address }}</div>
      </div>
      <div>
        <h2 class="font-display text-base font-semibold text-[var(--color-charcoal)]">{{ 'customer.order.shipping_address' | t }}</h2>
        <p class="mt-1 text-xs">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        <div class="mt-2 leading-relaxed">{{ order.shipping_address | format_address }}</div>
      </div>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "enabled_on": {
    "templates": ["customers/order"]
  }
}
{% endschema %}
