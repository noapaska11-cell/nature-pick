{%- liquid
  assign about_url = pages.about.url
  assign qr_url = request.origin | append: page.url
-%}
<section class="container-page grid gap-10 py-14 md:grid-cols-[auto_1fr] md:items-start">
  <div class="mx-auto flex w-fit flex-col items-center gap-3 rounded-3xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6">
    <div class="h-40 w-40 text-[var(--color-charcoal)] [&_svg]:h-full [&_svg]:w-full" data-qr data-url="{{ qr_url }}" role="img" aria-label="{{ 'np.origin_page.qr_caption' | t }}"></div>
    <p class="max-w-[10rem] text-center text-xs text-[var(--color-charcoal-soft)]">{{ 'np.origin_page.qr_caption' | t }}</p>
  </div>

  <div>
    <h2 class="font-display text-2xl font-semibold text-[var(--color-charcoal)]">{{ 'np.origin_page.why_title' | t }}</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-[var(--color-charcoal-soft)]">{{ 'np.origin_page.why_text' | t }}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <div class="card-surface p-5">
        {% render 'icon', name: 'map-pin', class: 'h-5 w-5 text-[var(--color-paprika)]' %}
        <h3 class="mt-3 font-display text-base font-medium text-[var(--color-charcoal)]">{{ 'np.origin_page.region_title' | t }}</h3>
        <p class="mt-1 text-sm text-[var(--color-charcoal-soft)]">{{ 'np.origin_page.region_text' | t }}</p>
      </div>
      <div class="card-surface p-5">
        {% render 'icon', name: 'shield', class: 'h-5 w-5 text-[var(--color-paprika)]' %}
        <h3 class="mt-3 font-display text-base font-medium text-[var(--color-charcoal)]">{{ 'np.origin_page.partner_title' | t }}</h3>
        <p class="mt-1 text-sm text-[var(--color-charcoal-soft)]">{{ 'np.origin_page.partner_text' | t }}</p>
      </div>
      <div class="card-surface p-5">
        {% render 'icon', name: 'box', class: 'h-5 w-5 text-[var(--color-paprika)]' %}
        <h3 class="mt-3 font-display text-base font-medium text-[var(--color-charcoal)]">{{ 'np.origin_page.packing_title' | t }}</h3>
        <p class="mt-1 text-sm text-[var(--color-charcoal-soft)]">{{ 'np.origin_page.packing_text' | t }}</p>
      </div>
      <div class="card-surface p-5">
        {% render 'icon', name: 'truck', class: 'h-5 w-5 text-[var(--color-paprika)]' %}
        <h3 class="mt-3 font-display text-base font-medium text-[var(--color-charcoal)]">{{ 'np.origin_page.delivery_title' | t }}</h3>
        <p class="mt-1 text-sm text-[var(--color-charcoal-soft)]">{{ 'np.origin_page.delivery_text' | t }}</p>
      </div>
    </div>

    {%- if about_url != blank -%}
      <a href="{{ about_url }}" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-paprika-dark)] hover:underline">
        {{ 'np.origin_page.cta_full_story' | t }} {% render 'icon', name: 'arrow-right', class: 'h-3.5 w-3.5' %}
      </a>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'np-qrcode.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product origin (QR)",
  "enabled_on": {
    "templates": ["page"]
  },
  "presets": [
    {
      "name": "Product origin (QR)"
    }
  ]
}
{% endschema %}
