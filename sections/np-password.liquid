{%- comment -%}Storefront password page: message, newsletter sign-up and the password form.{%- endcomment -%}
<div class="flex min-h-screen flex-col items-center justify-center bg-[var(--color-cream)] px-4 py-16 text-center">
  <div class="w-full max-w-md">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 300 | image_tag: loading: 'eager', alt: shop.name, class: 'mx-auto h-20 w-auto object-contain' }}
    {%- else -%}
      <img src="{{ 'np-logo.webp' | asset_url }}" width="600" height="600" alt="{{ shop.name | escape }}" class="mx-auto h-20 w-auto object-contain">
    {%- endif -%}

    <h1 class="mt-6 font-display text-3xl font-semibold text-[var(--color-charcoal)]">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="np-prose mt-3">{{ shop.password_message }}</div>
    {%- endif -%}

    <div class="mt-6 text-left">
      {% render 'np-newsletter-form', form_id: 'PasswordNewsletter' %}
    </div>

    {%- form 'storefront_password', class: 'mt-8 flex flex-col gap-3 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-5 text-left' -%}
      <p class="text-sm font-semibold text-[var(--color-charcoal)]">{{ 'general.password_page.login_form_heading' | t }}</p>
      <label for="PasswordInput" class="sr-only">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input id="PasswordInput" type="password" name="password" required autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" class="input-field" {% if form.errors %}aria-invalid="true"{% endif %}>
      {%- if form.errors -%}
        <p class="text-sm text-[var(--color-paprika-dark)]" role="alert">{{ 'general.password_page.login_form_error' | t }}</p>
      {%- endif -%}
      <button type="submit" class="btn-primary self-start">{{ 'general.password_page.login_form_submit' | t }}</button>
    {%- endform -%}

    <p class="mt-8 text-xs text-[var(--color-charcoal-soft)] [&_a]:underline">{{ 'general.password_page.admin_link_html' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
