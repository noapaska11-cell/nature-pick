{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'np.hero.eyebrow' | t
  endif
  assign title = section.settings.title
  if title == blank
    assign title = 'np.hero.title' | t
  endif
  assign subtitle = section.settings.subtitle
  if subtitle == blank
    assign subtitle = 'np.hero.subtitle' | t
  endif
  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'np.hero.cta' | t
  endif
  assign cta_link = section.settings.cta_link
  if cta_link == blank
    assign cta_link = '#bestsellers'
  endif
-%}
<section class="relative isolate overflow-hidden bg-[var(--color-charcoal)]">
  {%- comment -%}
    Desktop/tablet (sm+): full-bleed photo behind the text, darkened with a gradient for legibility.
    Mobile: the same gradient over a narrow screen would swallow almost the whole photo, so instead
    the photo runs as its own visible card below the text (see bottom of this section).
  {%- endcomment -%}
  <div class="absolute inset-0 -z-10 hidden sm:block">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '', class: 'h-full w-full object-cover', sizes: '100vw', widths: '768, 1200, 1600, 2000, 2400' }}
    {%- else -%}
      {%- comment -%} Default brand photo until a merchant picks their own in Theme settings > Hero. {%- endcomment -%}
      <img src="{{ 'np-hero-bg.webp' | asset_url }}" width="1671" height="941" loading="eager" fetchpriority="high" alt="" class="h-full w-full object-cover">
    {%- endif -%}
    <div class="absolute inset-0 np-hero-fade" aria-hidden="true"></div>
  </div>

  <div class="container-page flex min-h-[32rem] flex-col justify-center py-14 sm:min-h-[46rem] sm:py-28">
    <div class="max-w-2xl border-l-2 border-[var(--color-gold)] pl-6 sm:pl-8">
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-gold-on-dark)]">
        {% render 'icon', name: 'leaf', class: 'h-3.5 w-3.5' %} {{ eyebrow }}
      </span>
      <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.02] tracking-tight text-white sm:text-6xl sm:leading-[0.95] lg:text-8xl">{{ title }}</h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/80">{{ subtitle }}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="{{ cta_link }}" class="btn-primary px-8 py-4 text-base">
          {{ cta_label }}
          {% render 'icon', name: 'arrow-right', class: 'h-4 w-4' %}
        </a>
      </div>
    </div>

    {%- comment -%} Mobile only: the photo as its own card, fully visible instead of gradient-darkened. {%- endcomment -%}
    <div class="relative mt-8 h-56 overflow-hidden rounded-3xl sm:hidden">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '', class: 'h-full w-full object-cover', sizes: '100vw', widths: '600, 900, 1200' }}
      {%- else -%}
        <img src="{{ 'np-hero-bg.webp' | asset_url }}" width="1671" height="941" loading="eager" fetchpriority="high" alt="" class="h-full w-full object-cover">
      {%- endif -%}
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-charcoal)]/40 via-transparent to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-0 rounded-3xl ring-1 ring-inset ring-white/10" aria-hidden="true"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "np-section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background photo",
      "info": "Full-bleed photo behind the text (e.g. a product or lifestyle shot). Leave empty to use the default brand photo."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Leave empty to use the translated default text."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Leave empty to use the translated default text."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "info": "Leave empty to use the translated default text."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Leave empty to scroll to the bestsellers section (#bestsellers)."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
