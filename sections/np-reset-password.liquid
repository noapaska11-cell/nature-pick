<div class="container-page py-14">
  <div class="mx-auto max-w-md">
    <h1 class="font-display text-3xl font-semibold text-[var(--color-charcoal)]">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="mt-2 text-sm text-[var(--color-charcoal-soft)]">{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'reset_customer_password', novalidate: 'novalidate', class: 'mt-6 flex flex-col gap-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6' -%}
      {%- if form.errors -%}
        <div class="rounded-xl bg-[var(--color-paprika-light)] px-4 py-3 text-sm text-[var(--color-paprika-dark)]" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      {% render 'np-field', id: 'ResetPassword', name: 'customer[password]', type: 'password', label_key: 'customer.reset_password.password', autocomplete: 'new-password', required: true %}
      {% render 'np-field', id: 'ResetPasswordConfirm', name: 'customer[password_confirmation]', type: 'password', label_key: 'customer.reset_password.password_confirm', autocomplete: 'new-password', required: true %}
      <button type="submit" class="btn-primary">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "enabled_on": {
    "templates": ["customers/reset_password"]
  }
}
{% endschema %}
