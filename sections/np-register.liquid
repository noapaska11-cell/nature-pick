<div class="container-page py-14">
  <div class="mx-auto max-w-md">
    <h1 class="font-display text-3xl font-semibold text-[var(--color-charcoal)]">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer', novalidate: 'novalidate', class: 'mt-6 flex flex-col gap-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6' -%}
      {%- if form.errors -%}
        <div class="rounded-xl bg-[var(--color-paprika-light)] px-4 py-3 text-sm text-[var(--color-paprika-dark)]" role="alert">
          <p class="mb-1 flex items-center gap-1.5 font-semibold">{% render 'icon', name: 'alert', class: 'h-4 w-4' %} {{ 'templates.contact.form.error_heading' | t }}</p>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="grid gap-4 sm:grid-cols-2">
        {% render 'np-field', id: 'RegisterFirstName', name: 'customer[first_name]', label_key: 'customer.register.first_name', value: form.first_name, autocomplete: 'given-name' %}
        {% render 'np-field', id: 'RegisterLastName', name: 'customer[last_name]', label_key: 'customer.register.last_name', value: form.last_name, autocomplete: 'family-name' %}
      </div>
      {% render 'np-field', id: 'RegisterEmail', name: 'customer[email]', type: 'email', label_key: 'customer.register.email', value: form.email, autocomplete: 'email', required: true %}
      {% render 'np-field', id: 'RegisterPassword', name: 'customer[password]', type: 'password', label_key: 'customer.register.password', autocomplete: 'new-password', required: true %}
      <button type="submit" class="btn-primary">{{ 'customer.register.submit' | t }}</button>
      <a href="{{ routes.account_login_url }}" class="text-center text-sm text-[var(--color-charcoal-soft)] underline hover:text-[var(--color-charcoal)]">{{ 'customer.log_in' | t }}</a>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Register",
  "enabled_on": {
    "templates": ["customers/register"]
  }
}
{% endschema %}
