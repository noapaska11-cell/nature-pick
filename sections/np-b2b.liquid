{%- liquid
  # Handle routing for templates/page.json: until this theme is live, Shopify only lets a page pick templates of the
  # published theme, so the generic page template renders each designed section only on its own page handle.
  # Blank setting (every page.*.json template) = always shown.
  assign np_route_show = true
  assign np_route_handles = section.settings.route_handles | strip
  if np_route_handles != blank
    assign np_route_show = false
    assign np_route_list = np_route_handles | split: ','
    for np_route_handle in np_route_list
      assign np_route_handle = np_route_handle | strip
      if np_route_handle == page.handle
        assign np_route_show = true
        break
      endif
    endfor
  endif
-%}
{%- if np_route_show -%}
{%- comment -%}
  B2B page: audience list + a card with three tabs (register company / log in / request a quote).
  Registration (all required): first name, last name, e-mail, contact phone, country (dropdown), company address,
  VAT number, password + confirmation. Login: e-mail + password only. No OIB anywhere any more.
  Default (no server): registration goes to the store inbox through Shopify's contact form (without a password -
  a password must never travel by e-mail) and the owner approves the company by hand in the Shopify admin (customer
  tag); the login tab only shows a hint, since nothing can check it.
  With the verification service configured (Theme settings > B2B / wholesale) everything is live: the service
  validates every field again, keeps one account per e-mail address, stores only a salted password hash, and every
  registration waits as "pending" in its admin panel until the owner approves it (approved / rejected / suspended).
  An approved company logs in with e-mail + password; <np-b2b-session> in naturepick.js then switches this page from
  the tabs to the "B2B shop" panel and re-checks the session with the service on every visit. Links the service
  e-mails (set password, confirm e-mail) are finished here by <np-b2b-account-links>.

  Wholesale PRICING (np-price, np-product, cart) is decided on the server by Shopify's Liquid: snippets/np-b2b-customer
  (customer tag AND the b2b.status only the service can write), never by this page's token or by hiding elements.
  The login above proves the company is approved but does not by itself create a Shopify customer session, so the
  "active" panel also offers Shopify's own sign-in (same e-mail, Shopify e-mails a one-time code) once, unless the
  visitor already has an approved Shopify session - after that, pricing lights up everywhere.
{%- endcomment -%}
{%- liquid
  assign endpoint = settings.b2b_endpoint | strip
  assign login_endpoint = ''
  assign session_endpoint = ''
  assign password_request_endpoint = ''
  assign password_reset_endpoint = ''
  assign verify_endpoint = ''
  if endpoint != blank
    assign login_endpoint = endpoint | replace: '/register', '/login'
    assign session_endpoint = endpoint | replace: '/register', '/session'
    assign password_request_endpoint = endpoint | replace: '/register', '/password/request'
    assign password_reset_endpoint = endpoint | replace: '/register', '/password/reset'
    assign verify_endpoint = endpoint | replace: '/register', '/verify-email'
  endif
  # %COMPANY% is filled in by <np-b2b-session> once the logged-in company's name is known client-side
  assign active_text_template = 'np.b2b_auth.active_text' | t: company: '%COMPANY%'

  assign shopify_b2b_active = false
  if customer
    capture np_b2b_check
      render 'np-b2b-customer'
    endcapture
    if np_b2b_check contains 'true'
      assign shopify_b2b_active = true
    endif
  endif
  # only the return path is encoded - encoding the whole URL turned '/account/login?...' into a broken relative link
  assign return_path = page.url | url_encode
  assign shopify_login_url = routes.account_login_url | append: '?return_url=' | append: return_path
-%}
<section class="container-page grid gap-10 py-14 lg:grid-cols-[1fr_1.2fr]">
  <div>
    <h2 class="font-display text-xl font-semibold text-[var(--color-charcoal)]">{{ 'np.b2b_page.audience_title' | t }}</h2>
    <ul class="mt-4 flex flex-col gap-3">
      {%- for i in (1..4) -%}
        {%- assign audience_key = 'np.b2b_page.audience' | append: i -%}
        <li class="flex items-center gap-2 text-sm text-[var(--color-charcoal-soft)]">
          {% render 'icon', name: 'check', class: 'h-4 w-4 flex-shrink-0 text-[var(--color-olive-dark)]' %}
          {{ audience_key | t }}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <np-b2b-session class="block" data-endpoint="{{ session_endpoint }}" data-active-text-template="{{ active_text_template | strip | escape }}">
    {%- if endpoint != blank -%}
      {% render 'np-b2b-account-links', reset_endpoint: password_reset_endpoint, verify_endpoint: verify_endpoint %}
    {%- endif -%}
    <div data-b2b-guest>
      <np-tabs class="card-surface block scroll-mt-32 overflow-hidden" data-default="register" id="b2b-card">
        <div class="flex border-b border-[var(--color-line)]" role="tablist">
          <button type="button" role="tab" data-tab="register" aria-selected="true" class="flex flex-1 items-center justify-center gap-1.5 px-2 py-3.5 text-xs font-semibold text-[var(--color-charcoal-soft)] transition-colors hover:text-[var(--color-charcoal)] aria-selected:border-b-2 aria-selected:border-[var(--color-paprika)] aria-selected:text-[var(--color-charcoal)] sm:text-sm">
            {% render 'icon', name: 'building', class: 'h-4 w-4 flex-shrink-0' %} {{ 'np.b2b_auth.tab_register' | t }}
          </button>
          <button type="button" role="tab" data-tab="login" aria-selected="false" class="flex flex-1 items-center justify-center gap-1.5 px-2 py-3.5 text-xs font-semibold text-[var(--color-charcoal-soft)] transition-colors hover:text-[var(--color-charcoal)] aria-selected:border-b-2 aria-selected:border-[var(--color-paprika)] aria-selected:text-[var(--color-charcoal)] sm:text-sm">
            {% render 'icon', name: 'lock', class: 'h-4 w-4 flex-shrink-0' %} {{ 'np.b2b_auth.tab_login' | t }}
          </button>
          <button type="button" role="tab" data-tab="quote" aria-selected="false" class="flex flex-1 items-center justify-center gap-1.5 px-2 py-3.5 text-xs font-semibold text-[var(--color-charcoal-soft)] transition-colors hover:text-[var(--color-charcoal)] aria-selected:border-b-2 aria-selected:border-[var(--color-paprika)] aria-selected:text-[var(--color-charcoal)] sm:text-sm">
            {% render 'icon', name: 'chat', class: 'h-4 w-4 flex-shrink-0' %} {{ 'np.b2b_auth.tab_quote' | t }}
          </button>
        </div>

        <div class="p-6">
          <div role="tabpanel" data-panel="register">
            {%- if endpoint != blank -%}
              {% render 'np-b2b-register-form', endpoint: endpoint %}
            {%- else -%}
              {% render 'np-contact-form', kind: 'b2b_register', form_id: 'B2BRegisterForm' %}
            {%- endif -%}
            <p class="mt-4 text-center text-xs text-[var(--color-charcoal-soft)]">{{ 'np.b2b_auth.register_hint' | t }}</p>
          </div>

          <div role="tabpanel" data-panel="login" hidden>
            {%- if login_endpoint != blank -%}
              {% render 'np-b2b-login-form', endpoint: login_endpoint, password_endpoint: password_request_endpoint %}
            {%- else -%}
              <div class="flex flex-col items-center gap-4 py-6 text-center">
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-cream-soft)] text-[var(--color-charcoal)]">
                  {% render 'icon', name: 'lock', class: 'h-6 w-6' %}
                </span>
                <p class="max-w-xs text-sm leading-relaxed text-[var(--color-charcoal-soft)]">{{ 'np.b2b_auth.login_hint' | t }}</p>
              </div>
            {%- endif -%}
          </div>

          <div role="tabpanel" data-panel="quote" hidden>
            <p class="mb-4 text-sm leading-relaxed text-[var(--color-charcoal-soft)]">{{ 'np.b2b_page.form_note' | t }}</p>
            {% render 'np-contact-form', kind: 'b2b_quote', form_id: 'B2BQuoteForm' %}
          </div>
        </div>
      </np-tabs>
    </div>

    <div data-b2b-active hidden class="card-surface flex flex-col items-center gap-3 p-10 text-center">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-olive-light)] text-[var(--color-olive-dark)]">
        {% render 'icon', name: 'check', class: 'h-6 w-6' %}
      </span>
      <h3 class="font-display text-xl font-semibold text-[var(--color-charcoal)]">{{ 'np.b2b_auth.active_title' | t }}</h3>
      <p class="text-sm text-[var(--color-charcoal-soft)]" data-b2b-active-text></p>
      {%- unless shopify_b2b_active -%}
        <div class="mt-1 max-w-sm rounded-xl bg-[var(--color-cream-soft)] p-4 text-sm text-[var(--color-charcoal-soft)]">
          <p>{{ 'np.b2b_auth.shopify_login_hint' | t }}</p>
          <a href="{{ shopify_login_url }}" class="btn-secondary mt-3">{{ 'np.b2b_auth.shopify_login_cta' | t }}</a>
        </div>
      {%- endunless -%}
      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary">{{ 'np.b2b_auth.shop_cta' | t }}</a>
        <button type="button" data-b2b-logout class="btn-secondary">{{ 'np.b2b_auth.logout' | t }}</button>
      </div>
    </div>
  </np-b2b-session>
</section>
{%- endif -%}

{% schema %}
{
  "name": "B2B",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "presets": [
    {
      "name": "B2B"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "route_handles",
      "label": "Only on page handles",
      "info": "Comma-separated page handles, e.g. b2b. Leave empty to always show. Used by the default page template to show this section on its own page before page templates can be assigned."
    }
  ]
}
{% endschema %}
