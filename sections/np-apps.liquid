{%- comment -%}Container for Shopify app blocks (Judge.me reviews, subscriptions, ...).{%- endcomment -%}
<div class="container-page py-10">
  {%- for block in section.blocks -%}
    <div class="np-app-embed" {{ block.shopify_attributes }}>{% render block %}</div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Apps",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Apps"
    }
  ]
}
{% endschema %}
