{%- paginate search.results by 24 -%}
  <div class="container-page py-10">
    <h1 class="font-display text-3xl font-semibold text-[var(--color-charcoal)]">{{ 'templates.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="mt-6 flex max-w-xl items-center gap-2 rounded-full border border-[var(--color-line)] bg-[var(--color-paper)] p-1">
      <input type="hidden" name="options[prefix]" value="last">
      <label for="SearchPageInput" class="sr-only">{{ 'np.search.placeholder' | t }}</label>
      <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'np.search.placeholder' | t }}" class="w-full flex-1 rounded-full bg-transparent px-4 py-2.5 text-sm text-[var(--color-charcoal)] outline-none placeholder:text-[var(--color-charcoal-soft)] focus-visible:ring-2 focus-visible:ring-[var(--color-paprika)]">
      <button type="submit" aria-label="{{ 'general.search.search' | t }}" class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-paprika)] text-white hover:bg-[var(--color-paprika-dark)]">
        {% render 'icon', name: 'search', class: 'h-4 w-4' %}
      </button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="mt-8 text-[var(--color-charcoal-soft)]">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <p class="mt-6 text-sm text-[var(--color-charcoal-soft)]" role="status">{{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}</p>
        <div class="mt-8 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
          {%- for item in search.results -%}
            {%- case item.object_type -%}
              {%- when 'product' -%}
                {% render 'np-product-card', product: item, index: forloop.index0 %}
              {%- when 'article' -%}
                <a href="{{ item.url }}" class="group card-surface col-span-2 flex flex-col overflow-hidden">
                  {%- if item.image != blank -%}
                    {%- render 'np-product-image', image: item.image, alt: item.title, class: 'aspect-[16/9] w-full', sizes: '(min-width: 1024px) 50vw, 100vw', index: forloop.index0, icon: 'spice' -%}
                  {%- endif -%}
                  <div class="p-5">
                    <p class="text-xs text-[var(--color-charcoal-soft)]">{{ 'templates.search.page' | t }}</p>
                    <h2 class="mt-1 font-display text-lg font-medium text-[var(--color-charcoal)] group-hover:text-[var(--color-paprika-dark)]">{{ item.title | escape }}</h2>
                    <p class="mt-1 text-sm leading-relaxed text-[var(--color-charcoal-soft)]">{{ item.content | strip_html | truncate: 140 }}</p>
                  </div>
                </a>
              {%- else -%}
                <a href="{{ item.url }}" class="group card-surface col-span-2 flex flex-col p-5">
                  <p class="text-xs text-[var(--color-charcoal-soft)]">{{ 'templates.search.pages' | t }}</p>
                  <h2 class="mt-1 font-display text-lg font-medium text-[var(--color-charcoal)] group-hover:text-[var(--color-paprika-dark)]">{{ item.title | escape }}</h2>
                  <p class="mt-1 text-sm leading-relaxed text-[var(--color-charcoal-soft)]">{{ item.content | strip_html | truncate: 140 }}</p>
                </a>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {% render 'np-pagination', paginate: paginate %}
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
