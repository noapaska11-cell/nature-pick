      "label": "Overskrift",
      "default": "Vegan"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Tekst",
      "default": "Alle våre produkter er 100% plantebaserte."
    },
    {
      "type": "header",
      "content": "Logo 2"
    },
    {
      "type": "image_picker",
      "id": "logo_2",
      "label": "Bilde"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Overskrift",
      "default": "Glutenfri"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Tekst",
      "default": "Trygt for deg med glutenintoleranse."
    },
    {
      "type": "header",
      "content": "Logo 3"
    },
    {
      "type": "image_picker",
      "id": "logo_3",
      "label": "Bilde"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "Overskrift",
      "default": "Økologisk"
    },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Tekst",
      "default": "Sertifisert økologisk produksjon."
    },
    {
      "type": "header",
      "content": "Logo 4"
    },
    {
      "type": "image_picker",
      "id": "logo_4",
      "label": "Bilde"
    },
    {
      "type": "text",
      "id": "heading_4",
      "label": "Overskrift",
