{% doc %}
  @prompt
    Slideshow block with 5 fixed slides, desktop+mobile images, autoplay, arrows, dots, per-slide links.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-slideshow-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
    width: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} {
    min-width: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-slideshow-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} picture {
    display: block;
    width: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-slideshow-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-slideshow-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    opacity: {{ block.settings.nav_button_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-nav-{{ ai_gen_id }}:hover { opacity: 1; }
  .ai-slideshow-nav-{{ ai_gen_id }}--prev { left: {{ block.settings.nav_button_offset }}px; }
  .ai-slideshow-nav-{{ ai_gen_id }}--next { right: {{ block.settings.nav_button_offset }}px; }

  .ai-slideshow-nav-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.nav_button_size }}px * 0.5);
    height: calc({{ block.settings.nav_button_size }}px * 0.5);
  }

  {% if block.settings.show_arrows == false %}
    .ai-slideshow-nav-{{ ai_gen_id }} { display: none; }
  {% endif %}

  .ai-slideshow-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.dots_offset }}px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: {{ block.settings.dots_spacing }}px;
    z-index: 2;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    opacity: {{ block.settings.dot_inactive_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease, transform 0.3s ease;
    padding: 0;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}:hover { opacity: 1; }
  .ai-slideshow-dot-{{ ai_gen_id }}.active { opacity: 1; transform: scale(1.2); }
{% endstyle %}

<slideshow-{{ ai_gen_id }}
  class="ai-slideshow-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-slideshow-track-{{ ai_gen_id }}">
    {% liquid
      assign has_slides = false
      if block.settings.slide_1_image != blank or block.settings.slide_2_image != blank or block.settings.slide_3_image != blank or block.settings.slide_4_image != blank or block.settings.slide_5_image != blank
        assign has_slides = true
      endif
    %}

    {% for i in (1..5) %}
      {% liquid
        assign img_key = 'slide_' | append: i | append: '_image'
        assign mob_key = 'slide_' | append: i | append: '_mobile_image'
        assign lnk_key = 'slide_' | append: i | append: '_link'
        assign slide_img = block.settings[img_key]
        assign slide_mob = block.settings[mob_key]
        assign slide_lnk = block.settings[lnk_key]
      %}
      {% if slide_img != blank %}
        <div class="ai-slideshow-slide-{{ ai_gen_id }}">
          {% if slide_lnk != blank %}<a href="{{ slide_lnk }}" class="ai-slideshow-link-{{ ai_gen_id }}">{% endif %}
          <picture>
            {% if slide_mob != blank %}
              <source media="(max-width: 749px)" srcset="{{ slide_mob | image_url: width: 1000 }}">
            {% endif %}
            <img
              src="{{ slide_img | image_url: width: 2000 }}"
              alt="{{ slide_img.alt | escape }}"
              loading="lazy"
              width="{{ slide_img.width }}"
              height="{{ slide_img.height }}"
            >
          </picture>
          {% if slide_lnk != blank %}</a>{% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% if has_slides == false %}
      <div class="ai-slideshow-slide-{{ ai_gen_id }}">
        <div class="ai-slideshow-image-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      </div>
    {% endif %}
  </div>

  <button class="ai-slideshow-nav-{{ ai_gen_id }} ai-slideshow-nav-{{ ai_gen_id }}--prev" aria-label="Previous slide">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <button class="ai-slideshow-nav-{{ ai_gen_id }} ai-slideshow-nav-{{ ai_gen_id }}--next" aria-label="Next slide">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  {% if block.settings.show_dots %}
    <div class="ai-slideshow-dots-{{ ai_gen_id }}"></div>
  {% endif %}
</slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class Slideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-slideshow-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-slideshow-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slideshow-nav-{{ ai_gen_id }}--prev');
        this.nextButton = this.querySelector('.ai-slideshow-nav-{{ ai_gen_id }}--next');
        this.dotsContainer = this.querySelector('.ai-slideshow-dots-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.speed = parseInt(this.dataset.speed) * 1000;

        if (this.slides.length === 0) return;

        this.setupDots();
        this.setupEventListeners();
        this.updateSlidePosition();

        if (this.autoplay && this.slides.length > 1) this.startAutoplay();
      }

      setupDots() {
        if (!this.dotsContainer) return;
        this.dotsContainer.innerHTML = '';
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-slideshow-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          if (index === 0) dot.classList.add('active');
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            if (this.autoplay) this.resetAutoplay();
          });
          this.dotsContainer.appendChild(dot);
        });
        this.dots = this.querySelectorAll('.ai-slideshow-dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => { this.previousSlide(); if (this.autoplay) this.resetAutoplay(); });
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => { this.nextSlide(); if (this.autoplay) this.resetAutoplay(); });
        }
        this.addEventListener('mouseenter', () => { if (this.autoplay) this.stopAutoplay(); });
        this.addEventListener('mouseleave', () => { if (this.autoplay) this.startAutoplay(); });
      }

      goToSlide(index) { this.currentSlide = index; this.updateSlidePosition(); this.updateDots(); }
      nextSlide() { this.currentSlide = (this.currentSlide + 1) % this.slides.length; this.updateSlidePosition(); this.updateDots(); }
      previousSlide() { this.currentSlide = (this.currentSlide - 1 + this.slides.length) % this.slides.length; this.updateSlidePosition(); this.updateDots(); }
      updateSlidePosition() { this.track.style.transform = `translateX(${-this.currentSlide * 100}%)`; }
      updateDots() { if (!this.dots) return; this.dots.forEach((dot, i) => dot.classList.toggle('active', i === this.currentSlide)); }
      startAutoplay() { this.autoplayInterval = setInterval(() => this.nextSlide(), this.speed); }
      stopAutoplay() { if (this.autoplayInterval) { clearInterval(this.autoplayInterval); this.autoplayInterval = null; } }
      resetAutoplay() { this.stopAutoplay(); this.startAutoplay(); }
      disconnectedCallback() { this.stopAutoplay(); }
    }

    customElements.define('slideshow-{{ ai_gen_id }}', Slideshow{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Slideshow",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Slide 1" },
    { "type": "image_picker", "id": "slide_1_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "slide_1_mobile_image", "label": "Mobile image" },
    { "type": "url", "id": "slide_1_link", "label": "Link" },
    { "type": "header", "content": "Slide 2" },
    { "type": "image_picker", "id": "slide_2_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "slide_2_mobile_image", "label": "Mobile image" },
    { "type": "url", "id": "slide_2_link", "label": "Link" },
    { "type": "header", "content": "Slide 3" },
    { "type": "image_picker", "id": "slide_3_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "slide_3_mobile_image", "label": "Mobile image" },
    { "type": "url", "id": "slide_3_link", "label": "Link" },
    { "type": "header", "content": "Slide 4" },
    { "type": "image_picker", "id": "slide_4_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "slide_4_mobile_image", "label": "Mobile image" },
    { "type": "url", "id": "slide_4_link", "label": "Link" },
    { "type": "header", "content": "Slide 5" },
    { "type": "image_picker", "id": "slide_5_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "slide_5_mobile_image", "label": "Mobile image" },
    { "type": "url", "id": "slide_5_link", "label": "Link" },
    { "type": "header", "content": "Autoplay" },
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "header", "content": "Navigation arrows" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show navigation arrows", "default": true },
    { "type": "range", "id": "nav_button_size", "label": "Arrow size", "min": 30, "max": 60, "step": 5, "unit": "px", "default": 45 },
    { "type": "range", "id": "nav_button_offset", "label": "Arrow offset from edge", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "nav_button_opacity", "label": "Arrow opacity", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 70 },
    { "type": "color", "id": "nav_button_color", "label": "Arrow background", "default": "#ffffff" },
    { "type": "color", "id": "nav_button_icon_color", "label": "Arrow icon color", "default": "#000000" },
    { "type": "header", "content": "Navigation dots" },
    { "type": "checkbox", "id": "show_dots", "label": "Show navigation dots", "default": true },
    { "type": "range", "id": "dot_size", "label": "Dot size", "min": 6, "max": 16, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "dots_spacing", "label": "Spacing between dots", "min": 4, "max": 16, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "dots_offset", "label": "Dots offset from bottom", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "dot_inactive_opacity", "label": "Inactive dot opacity", "min": 20, "max": 80, "step": 5, "unit": "%", "default": 50 },
    { "type": "color", "id": "dot_color", "label": "Dot color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Slideshow" }]
}
{% endschema %}