  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_size",
        "min": 32,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Logo height",
        "default": 56
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32 px PNG"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social sharing image",
        "info": "1200 x 630 px. Used when a page has no image of its own."
      }
    ]
  },
